@model CareLink360.Domain.Entities.Client

@{
    ViewData["Title"] = "Client Details";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-info text-white">

            <h3>Client Details</h3>

        </div>

        <div class="card-body">

            <table class="table">

                <tr>

                    <th>Full Name</th>

                    <td>@Model.FullName</td>

                </tr>

                <tr>

                    <th>Phone Number</th>

                    <td>@Model.PhoneNumber</td>

                </tr>

                <tr>

                    <th>City</th>

                    <td>@Model.City</td>

                </tr>

                <tr>

                    <th>Address</th>

                    <td>@Model.HomeAddress</td>

                </tr>

            </table>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </div>

    </div>

</div>