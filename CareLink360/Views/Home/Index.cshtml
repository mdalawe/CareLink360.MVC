@{
    ViewData["Title"] = "CareLink360";
}

<section class="hero">

    <div class="hero-left">

        <span class="hero-tag">
            COMPASSIONATE CARE. EVERY TIME.
        </span>

        <h1>
            Better Care.<br />
            Stronger Connections.
        </h1>

        <p>
            CareLink360 is a complete healthcare platform that connects
            patients, caregivers, and providers to deliver better care
            and better outcomes.
        </p>

        <div class="hero-buttons">

            <a asp-controller="Auth"
               asp-action="Login"
               class="btn-login">
                Login
            </a>

            <a asp-controller="Auth"
               asp-action="Register"
               class="btn-register">
                Create Account
            </a>

        </div>

        <div class="stats">

            <div class="stat-item">
                <h3>10K+</h3>
                <span>Patients</span>
            </div>

            <div class="stat-item">
                <h3>5K+</h3>
                <span>Caregivers</span>
            </div>

            <div class="stat-item">
                <h3>500+</h3>
                <span>Providers</span>
            </div>

        </div>

    </div>

    <div class="hero-right">

       <img src="/images/Caregiver.jpg"
     alt="Caregiver assisting senior"
     class="hero-img">

    </div>

</section>

<section class="platform-section">

    <div class="section-title">
        <span>OUR PLATFORM</span>
        <h2>Everything You Need In One Place</h2>
    </div>

    <div class="platform-grid">

        <div class="platform-card">
            <h3>Caregivers</h3>
            <p>Manage caregiver profiles and assignments.</p>
        </div>

        <div class="platform-card">
            <h3>Clients</h3>
            <p>Manage client information and care plans.</p>
        </div>

        <div class="platform-card">
            <h3>Job Requests</h3>
            <p>Track caregiver requests and assignments.</p>
        </div>

        <div class="platform-card">
            <h3>Payments</h3>
            <p>Secure billing and payment management.</p>
        </div>

        <div class="platform-card">
            <h3>Medical Records</h3>
            <p>Access healthcare information securely.</p>
        </div>

    </div>

</section>