<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - CareLink360</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/home.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/CareLink360.styles.css"
          asp-append-version="true" />

    <style>

        /* ===== CARELINK360 PUBLIC NAVBAR ===== */

        .cl-navbar {
            position: sticky;
            top: 0;
            z-index: 1030;
            background: rgba(255, 255, 255, 0.88);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            padding: 12px 0;
            border-bottom: 1px solid #e6eef2;
        }

        .cl-navbar::after {
            content: "";
            position: absolute;
            left: 0;
            right: 0;
            bottom: -1px;
            height: 3px;
            background: linear-gradient(90deg, #1264d8, #16a085);
        }

        .cl-brand {
            display: flex;
            align-items: center;
            gap: 12px;
            text-decoration: none;
        }

        .cl-brand-icon {
            width: 44px;
            height: 44px;
            border-radius: 13px;
            background: linear-gradient(135deg, #1264d8, #16a085);
            color: #ffffff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 19px;
            box-shadow: 0 6px 16px rgba(18, 100, 216, 0.25);
        }

        .cl-brand-name {
            font-size: 24px;
            font-weight: 800;
            line-height: 1;
            color: #17324d;
            letter-spacing: -0.5px;
        }

        .cl-brand-name span {
            background: linear-gradient(90deg, #1264d8, #16a085);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .cl-brand-tagline {
            display: block;
            margin-top: 4px;
            font-size: 11px;
            font-weight: 600;
            color: #7a8b8f;
            letter-spacing: 0.4px;
            text-transform: uppercase;
        }

        .cl-links {
            display: flex;
            align-items: center;
            gap: 6px;
            margin: 0 auto;
            padding: 5px;
            list-style: none;
            background: #f3f7f9;
            border-radius: 999px;
        }

        .cl-link {
            display: inline-block;
            padding: 8px 18px;
            border-radius: 999px;
            color: #4a5d70;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.2s ease;
        }

        .cl-link:hover {
            color: #1264d8;
            background: #ffffff;
        }

        .cl-link.active {
            color: #ffffff;
            background: linear-gradient(135deg, #1264d8, #16a085);
            box-shadow: 0 4px 12px rgba(18, 100, 216, 0.25);
        }

        .cl-toggler {
            border: none;
            background: #f3f7f9;
            color: #17324d;
            border-radius: 10px;
            padding: 8px 12px;
        }

        @@media (max-width: 991px) {
            .cl-links {
                flex-direction: column;
                align-items: stretch;
                border-radius: 16px;
                margin-top: 14px;
            }

            .cl-link {
                text-align: center;
            }
        }

    </style>
</head>

<body>

    @{
        var controller = ViewContext.RouteData.Values["controller"]?.ToString();
        var action = ViewContext.RouteData.Values["action"]?.ToString();

        bool isHomePage =
        controller == "Home" &&
        action == "Index";

        bool isAuthPage =
        controller == "Auth" &&
        (action == "Login" || action == "Register");

        string ActiveIf(string name) =>
        controller == name ? "active" : "";
    }

    <header>

        <nav class="cl-navbar navbar navbar-expand-lg">

            <div class="container-fluid px-4">

                <!-- BRAND -->
                <a class="cl-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <div class="cl-brand-icon">
                        <i class="fa-solid fa-heart-pulse"></i>
                    </div>

                    <div>
                        <div class="cl-brand-name">
                            CareLink<span>360</span>
                        </div>

                        <small class="cl-brand-tagline">
                            Healthcare Management
                        </small>
                    </div>

                </a>

                @if (!isAuthPage)
                {
                    <button class="cl-toggler navbar-toggler"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#clNav">
                        <i class="fa-solid fa-bars"></i>
                    </button>

                    <div class="collapse navbar-collapse" id="clNav">

                        <ul class="cl-links">

                        </ul>

                    </div>
                }

            </div>

        </nav>

    </header>

    <main>

        @RenderBody()

    </main>

    <footer class="footer text-center py-4">

        <p class="mb-0">
            © 2026 CareLink360. All Rights Reserved.
        </p>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>