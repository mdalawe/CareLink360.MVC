@model IEnumerable<CareLink360.Application.DTOs.CaregiverResponseDto>

@{
    ViewData["Title"] = "Caregivers";

    var caregivers = Model?.ToList() ?? new List<CareLink360.Application.DTOs.CaregiverResponseDto>();

    var totalCaregivers = caregivers.Count;
    var availableCaregivers = caregivers.Count(x => x.IsAvaliable);
    var verifiedCaregivers = caregivers.Count(x => x.IsNinVerified);
    var pendingCaregivers = totalCaregivers - verifiedCaregivers;
}

