@model List<CareLink360.Domain.Entities.JobRequest>
@{
    ViewData["Title"] = "Job Requests";
    Layout = "_AdminLayout";
}

<div class="dashboard-card mb-3">
    <div class="d-flex justify-content-between align-items-start">
        <div>
            <h5>Job Requests</h5>
            <p class="subtitle mb-0">Requests sent between clients and caregivers</p>
        </div>
        <a asp-action="Create" class="btn btn-carelink">
            <i class="fa-solid fa-plus me-1"></i> New Request
        </a>
    </div>
</div>

<div class="dashboard-table">
    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <i class="fa-solid fa-inbox"></i>
            No job requests yet.
        </div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Client</th>
                    <th>Caregiver</th>
                    <th>Location</th>
                    <th>Status</th>
                    <th>Requested</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model)
                {
                    <tr>
                        <td><span class="id-chip">@request.ClientId.ToString().Substring(0, 8)</span></td>
                        <td><span class="id-chip">@request.CaregiverId.ToString().Substring(0, 8)</span></td>
                        <td>@request.Location</td>
                        <td>
                            <span class="status-badge status-@request.Status">@request.Status</span>
                        </td>
                        <td>@request.RequestedAt.ToString("MMM dd, yyyy")</td>
                        <td class="text-end">
                            @if (request.Status == "Pending")
                            {
                                <form asp-action="Accept" asp-route-id="@request.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-success">
                                        <i class="fa-solid fa-check"></i> Accept
                                    </button>
                                </form>
                                <form asp-action="Reject" asp-route-id="@request.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fa-solid fa-xmark"></i> Reject
                                    </button>
                                </form>
                            }
                            else
                            {
                                <span class="person-sub">No actions</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>