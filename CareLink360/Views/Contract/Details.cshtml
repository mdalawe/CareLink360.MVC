```cshtml
@model CareLink360.Domain.Entities.Contract

@{
    ViewData["Title"] = "Contract Details";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-info text-white">
            <h3>Contract Details</h3>
        </div>

        <div class="card-body">

            <table class="table">

                <tr>
                    <th>Client ID</th>
                    <td>@Model.ClientId</td>
                </tr>

                <tr>
                    <th>Caregiver ID</th>
                    <td>@Model.CaregiverId</td>
                </tr>

                <tr>
                    <th>Job Request ID</th>
                    <td>@Model.JobRequestId</td>
                </tr>

                <tr>
                    <th>Status</th>
                    <td>@Model.Status</td>
                </tr>

                <tr>
                    <th>Start Date</th>
                    <td>@Model.StartDate.ToShortDateString()</td>
                </tr>

                <tr>
                    <th>End Date</th>
                    <td>
                        @(Model.EndDate.HasValue
                            ? Model.EndDate.Value.ToShortDateString()
                            : "Not completed")
                    </td>
                </tr>

            </table>

            <a asp-action="Index"
               class="btn btn-secondary">
                Back
            </a>

        </div>

    </div>

</div>