@model CareLink360.Domain.Entities.NinVerification

@{
    ViewData["Title"] = "Approve NIN";
}

<div class="container mt-5">

    <div class="alert alert-success">

        <h3>Approve Verification</h3>

        <p>

            Approve this user's NIN verification?

        </p>

        <form asp-action="ApproveConfirmed">

            <input asp-for="Id"
                   type="hidden" />

            <button class="btn btn-success">

                Approve

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                Cancel

            </a>

        </form>

    </div>

</div>