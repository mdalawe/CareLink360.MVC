@model CareLink360.Domain.Entities.NinVerification

@{
    ViewData["Title"] = "Reject NIN";
}

<div class="container mt-5">

    <div class="alert alert-danger">

        <h3>Reject Verification</h3>

        <p>

            Reject this NIN verification?

        </p>

        <form asp-action="RejectConfirmed">

            <input asp-for="Id"
                   type="hidden" />

            <button class="btn btn-danger">

                Reject

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                Cancel

            </a>

        </form>

    </div>

</div>