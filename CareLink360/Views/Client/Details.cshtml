@model CareLink360.Domain.Entities.Client

@{
    ViewData["Title"] = "Client Details";
    Layout = "_AdminLayout";
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <a asp-controller="Client"
           asp-action="Index"
           class="btn btn-light border">
            <i class="fa-solid fa-arrow-left me-2"></i>
            Back to Clients
        </a>
    </div>

    <div class="client-details-card">

        <div class="client-details-header">
            <div class="client-avatar">
                @((Model.FirstName?.FirstOrDefault().ToString() ?? "C").ToUpper())
            </div>

            <div>
                <h2 class="mb-1">
                    @Model.FirstName @Model.LastName
                </h2>
                <p class="mb-0">Client Profile</p>
            </div>
        </div>

        <div class="client-details-body">

            <h5 class="section-heading mb-4">
                <i class="fa-solid fa-address-card me-2"></i>
                Client Information
            </h5>

            <div class="row g-4">

                <div class="col-md-6">
                    <div class="info-box">
                        <span class="info-label">First Name</span>
                        <strong>@Model.FirstName</strong>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-box">
                        <span class="info-label">Last Name</span>
                        <strong>@Model.LastName</strong>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-box">
                        <span class="info-label">Phone Number</span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.PhoneNumber)
                                ? "Not provided"
                                : Model.PhoneNumber)
                        </strong>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="info-box">
                        <span class="info-label">City</span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.City)
                                ? "Not provided"
                                : Model.City)
                        </strong>
                    </div>
                </div>

                <div class="col-12">
                    <div class="info-box">
                        <span class="info-label">Home Address</span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.HomeAddress)
                                ? "Not provided"
                                : Model.HomeAddress)
                        </strong>
                    </div>
                </div>

            </div>

            <div class="mt-4 d-flex gap-2 flex-wrap">
                <a asp-controller="Client"
                   asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    <i class="fa-solid fa-pen-to-square me-2"></i>
                    Edit Client
                </a>

                <a asp-controller="Client"
                   asp-action="Index"
                   class="btn btn-outline-secondary">
                    Back to Client Management
                </a>
            </div>

        </div>
    </div>
</div>

<style>
    .client-details-card {
        max-width: 900px;
        margin: 0 auto;
        background: #fff;
        border: 1px solid #e3ebf0;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 8px 25px rgba(25, 55, 80, .07);
    }

    .client-details-header {
        display: flex;
        align-items: center;
        gap: 20px;
        padding: 28px;
        background: #eff8f8;
        border-bottom: 1px solid #e3ebf0;
    }

    .client-avatar {
        width: 68px;
        height: 68px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #d5f1e9;
        color: #13845c;
        font-size: 25px;
        font-weight: 700;
    }

    .client-details-header h2 {
        color: #17324d;
        font-weight: 700;
    }

    .client-details-header p {
        color: #64788a;
    }

    .client-details-body {
        padding: 28px;
    }

    .section-heading {
        color: #17324d;
        font-weight: 700;
    }

    .info-box {
        display: flex;
        flex-direction: column;
        gap: 7px;
        min-height: 80px;
        padding: 16px;
        background: #f8fafb;
        border: 1px solid #e8eef2;
        border-radius: 10px;
        overflow-wrap: anywhere;
    }

    .info-label {
        color: #718096;
        font-size: 13px;
    }

    .info-box strong {
          color: #243b53;
    }

    @@media (max-width: 576px) {
        .client-details-header,
        .client-details-body {
            padding: 20px;
        }
    }
</style>
