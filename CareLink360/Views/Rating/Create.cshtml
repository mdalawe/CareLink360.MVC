@model CareLink360.Application.DTOs.CreateRatingDto

@{
    ViewData["Title"] = "Create Rating";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">

            <h3>Rate Caregiver</h3>

        </div>

        <div class="card-body">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <div class="mb-3">

                    <label asp-for="CaregiverId"></label>

                    <input asp-for="CaregiverId"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label asp-for="ClientId"></label>

                    <input asp-for="ClientId"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label asp-for="Score"></label>

                    <select asp-for="Score"
                            class="form-select">

                        <option value="1">⭐ 1</option>

                        <option value="2">⭐⭐ 2</option>

                        <option value="3">⭐⭐⭐ 3</option>

                        <option value="4">⭐⭐⭐⭐ 4</option>

                        <option value="5">⭐⭐⭐⭐⭐ 5</option>

                    </select>

                </div>

                <div class="mb-3">

                    <label asp-for="Comment"></label>

<textarea asp-for="Comment"
          rows="5"
          class="form-control"></textarea>

                </div>

                <button class="btn btn-success">

                    Submit Rating

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}