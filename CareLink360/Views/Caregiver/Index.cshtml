            border-color: #066873;
            background: #066873;
        }

    .stat-card {
        display: flex;
        align-items: center;
        gap: 16px;
        height: 100%;
        padding: 22px;
        border: 1px solid #e0e7f0;
        border-radius: 13px;
        background: #fff;
        box-shadow: 0 3px 10px rgba(20,45,75,.045);
        transition: transform .2s ease, box-shadow .2s ease;
    }

