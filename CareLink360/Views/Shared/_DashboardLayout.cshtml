@{
    var title = ViewData["Title"]?.ToString() ?? "Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@title - CareLink360</title>


    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />


    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />


    <style>

        /* =========================================
           GENERAL
        ========================================= */

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            padding: 0;
            min-height: 100%;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f5f7fb;
            color: #263238;
        }


        /* =========================================
           SIDEBAR
        ========================================= */

        .sidebar {
            position: fixed;
            top: 0;
            left: 0;
            width: 250px;
            height: 100vh;
            background: #ffffff;
            border-right: 1px solid #e8e8e8;
            z-index: 1000;
            overflow-y: auto;
            transition: all 0.3s ease;
        }


        /* =========================================
           BRAND
        ========================================= */

        .brand {
            height: 70px;
            display: flex;
            align-items: center;
            padding: 0 25px;
            border-bottom: 1px solid #eeeeee;
            font-size: 21px;
            font-weight: 700;
            color: #0b8f87;
        }

            .brand i {
                margin-right: 10px;
                font-size: 23px;
            }


        /* =========================================
           MENU TITLE
        ========================================= */

        .menu-title {
            padding: 25px 25px 10px;
            font-size: 11px;
            font-weight: 700;
            color: #9aa0a6;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }


        /* =========================================
           SIDEBAR LINKS
        ========================================= */

        .sidebar a {
            display: flex;
            align-items: center;
            gap: 13px;
            padding: 12px 20px;
            margin: 3px 10px;
            border-radius: 8px;
            text-decoration: none;
            color: #59636e;
            font-size: 14px;
            transition: all 0.2s ease;
        }


            .sidebar a i {
                width: 22px;
                text-align: center;
                font-size: 15px;
            }


            .sidebar a:hover {
                background: #e9f8f6;
                color: #0b8f87;
            }


            .sidebar a.active {
                background: #0b8f87;
                color: #ffffff;
                box-shadow: 0 4px 10px rgba(11, 143, 135, 0.15);
            }


        /* =========================================
           MAIN AREA
        ========================================= */

        .main {
            margin-left: 250px;
            min-height: 100vh;
            transition: all 0.3s ease;
        }


        /* =========================================
           TOP BAR
        ========================================= */

        .topbar {
            height: 70px;
            background: #ffffff;
            border-bottom: 1px solid #eeeeee;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 30px;
            position: sticky;
            top: 0;
            z-index: 900;
        }


        .page-title {
            font-size: 20px;
            font-weight: 600;
            color: #263238;
        }


        .topbar-right {
            display: flex;
            align-items: center;
            gap: 25px;
        }


        /* =========================================
           NOTIFICATION
        ========================================= */

        .notification {
            position: relative;
            font-size: 18px;
            color: #59636e;
            cursor: pointer;
        }


            .notification:hover {
                color: #0b8f87;
            }


        .notification-badge {
            position: absolute;
            top: -8px;
            right: -8px;
            background: #e74c3c;
            color: white;
            font-size: 9px;
            width: 17px;
            height: 17px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }


        /* =========================================
           PROFILE
        ========================================= */

        .profile {
            display: flex;
            align-items: center;
            gap: 10px;
        }


        .profile-avatar {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: #0b8f87;
            color: white;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: 15px;
        }


        .profile-info strong {
            display: block;
            font-size: 13px;
            color: #263238;
        }


        .profile-info small {
            display: block;
            color: #8a9299;
            font-size: 11px;
        }


        /* =========================================
           CONTENT
        ========================================= */

        .content {
            padding: 30px;
        }


        /* =========================================
           WELCOME SECTION
        ========================================= */

        .welcome {
            margin-bottom: 25px;
        }


            .welcome h2 {
                font-size: 25px;
                font-weight: 600;
                margin-bottom: 5px;
            }


            .welcome p {
                color: #8a9299;
                margin: 0;
            }


        /* =========================================
           STAT CARDS
        ========================================= */

        .stat-card {
            background: #ffffff;
            border-radius: 12px;
            padding: 22px;
            border: 1px solid #eeeeee;
            height: 100%;
            transition: all 0.2s ease;
        }


            .stat-card:hover {
                transform: translateY(-3px);
                box-shadow: 0 8px 25px rgba(0, 0, 0, 0.06);
            }


        .stat-icon {
            width: 48px;
            height: 48px;
            border-radius: 10px;
            background: #e9f8f6;
            color: #0b8f87;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            margin-bottom: 15px;
        }


        .stat-title {
            color: #8a9299;
            font-size: 13px;
            margin-bottom: 5px;
        }


        .stat-number {
            font-size: 27px;
            font-weight: 700;
            color: #263238;
        }


        /* =========================================
           DASHBOARD CARD
        ========================================= */

        .dashboard-card {
            background: #ffffff;
            border-radius: 12px;
            border: 1px solid #eeeeee;
            padding: 25px;
            height: 100%;
        }


            .dashboard-card h5 {
                font-size: 17px;
                font-weight: 600;
                margin-bottom: 20px;
            }


        /* =========================================
           BUTTON
        ========================================= */

        .btn-carelink {
            background: #0b8f87;
            color: #ffffff;
            border: none;
            padding: 9px 17px;
            border-radius: 7px;
            transition: all 0.2s ease;
        }


            .btn-carelink:hover {
                background: #08736d;
                color: #ffffff;
            }


        /* =========================================
           BACK BUTTON
        ========================================= */

        .back-button {
            margin-bottom: 20px;
        }


            .back-button button {
                border-radius: 7px;
            }


        /* =========================================
           TABLE
        ========================================= */

        .dashboard-table {
            background: #ffffff;
            border-radius: 12px;
            border: 1px solid #eeeeee;
            overflow: hidden;
        }


            .dashboard-table table {
                margin: 0;
            }


            .dashboard-table th {
                background: #f8fafb;
                color: #59636e;
                font-size: 13px;
                font-weight: 600;
                padding: 15px;
            }


            .dashboard-table td {
                padding: 15px;
                font-size: 13px;
                vertical-align: middle;
            }


        /* =========================================
           STATUS BADGES
        ========================================= */

        .status-badge {
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 600;
        }


        .status-active {
            background: #e7f7ed;
            color: #218739;
        }


        .status-pending {
            background: #fff4d6;
            color: #a87900;
        }


        .status-inactive {
            background: #fde8e8;
            color: #c0392b;
        }


        /* =========================================
           FOOTER
        ========================================= */

        .footer {
            padding: 20px 30px;
            color: #999999;
            font-size: 13px;
            text-align: center;
        }


        /* =========================================
           SCROLLBAR
        ========================================= */

        .sidebar::-webkit-scrollbar {
            width: 5px;
        }


        .sidebar::-webkit-scrollbar-thumb {
            background: #dddddd;
            border-radius: 10px;
        }


        /* =========================================
           TABLET
        ========================================= */

        @@media (max-width: 992px) {

            .sidebar {
                width: 210px;
            }

            .main {
                margin-left: 210px;
            }

            .content {
                padding: 25px;
            }
        }


        /* =========================================
           MOBILE
        ========================================= */

        @@media (max-width: 768px) {

            .sidebar {
                width: 70px;
            }


            .brand {
                justify-content: center;
                padding: 0;
            }


                .brand span {
                    display: none;
                }


                .brand i {
                    margin: 0;
                }


            .menu-title {
                display: none;
            }


            .sidebar a {
                justify-content: center;
                padding: 14px 10px;
                margin: 3px 8px;
            }


                .sidebar a span {
                    display: none;
                }


                .sidebar a i {
                    margin: 0;
                    font-size: 17px;
                }


            .main {
                margin-left: 70px;
            }


            .content {
                padding: 20px;
            }


            .profile-info {
                display: none;
            }


            .topbar {
                padding: 0 20px;
            }


            .topbar-right {
                gap: 15px;
            }
        }


        /* =========================================
           SMALL MOBILE
        ========================================= */

        @@media (max-width: 480px) {

            .sidebar {
                width: 60px;
            }


            .main {
                margin-left: 60px;
            }


            .content {
                padding: 15px;
            }


            .topbar {
                height: 60px;
                padding: 0 15px;
            }


            .page-title {
                font-size: 16px;
            }


            .profile-avatar {
                width: 34px;
                height: 34px;
            }


            .notification {
                font-size: 16px;
            }
        }
    </style>

</head>


<body>


    <!-- =====================================================
         SIDEBAR
    ====================================================== -->

    <aside class="sidebar">


        <!-- BRAND -->

        <div class="brand">

            <i class="fa-solid fa-heart-pulse"></i>

            <span>
                CareLink360
            </span>

        </div>


        <!-- MAIN MENU -->

        <div class="menu-title">
            Main
        </div>


        <!-- DASHBOARD -->

        <a asp-controller="AdminDashboard"
           asp-action="Index">

            <i class="fa-solid fa-chart-line"></i>

            <span>
                Dashboard
            </span>

        </a>


        <!-- CAREGIVERS -->

        <a asp-controller="Caregiver"
           asp-action="Index">

            <i class="fa-solid fa-user-nurse"></i>

            <span>
                Caregivers
            </span>

        </a>


        <!-- CLIENTS -->

        <a asp-controller="Client"
           asp-action="Index">

            <i class="fa-solid fa-users"></i>

            <span>
                Clients
            </span>

        </a>


        <!-- JOB REQUESTS -->

        <a asp-controller="JobRequest"
           asp-action="Index">

            <i class="fa-solid fa-briefcase"></i>

            <span>
                Job Requests
            </span>

        </a>


        <!-- CONTRACTS -->

        <a asp-controller="Contract"
           asp-action="Index">

            <i class="fa-solid fa-file-contract"></i>

            <span>
                Contracts
            </span>

        </a>


        <!-- PAYMENTS -->

        <a asp-controller="Payment"
           asp-action="Index">

            <i class="fa-solid fa-credit-card"></i>

            <span>
                Payments
            </span>

        </a>



        <!-- MANAGEMENT -->

        <div class="menu-title">
            Management
        </div>


        <!-- NIN -->

        <a asp-controller="NinVerification"
           asp-action="Index">

            <i class="fa-solid fa-id-card"></i>

            <span>
                NIN Verification
            </span>

        </a>


        <!-- MEDICAL -->

        <a asp-controller="Medical"
           asp-action="Index">

            <i class="fa-solid fa-heart-pulse"></i>

            <span>
                Medical Records
            </span>

        </a>


        <!-- RATINGS -->

        <a asp-controller="Rating"
           asp-action="Index">

            <i class="fa-solid fa-star"></i>

            <span>
                Ratings & Reviews
            </span>

        </a>



        <!-- SYSTEM -->

        <div class="menu-title">
            System
        </div>


        <!-- HOME -->

        <a asp-controller="Home"
           asp-action="Index">

            <i class="fa-solid fa-house"></i>

            <span>
                Website
            </span>

        </a>


        <!-- LOGOUT -->

        <a asp-controller="Auth"
           asp-action="Logout">

            <i class="fa-solid fa-right-from-bracket"></i>

            <span>
                Logout
            </span>

        </a>


    </aside>



    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main class="main">


        <!-- =================================================
             TOPBAR
        ================================================== -->

        <header class="topbar">


            <!-- PAGE TITLE -->

            <div class="page-title">

                @title

            </div>



            <!-- TOPBAR RIGHT -->

            <div class="topbar-right">


                <!-- NOTIFICATION -->

                <div class="notification">

                    <i class="fa-regular fa-bell"></i>

                    <span class="notification-badge">
                        3
                    </span>

                </div>



                <!-- PROFILE -->

                <div class="profile">


                    <div class="profile-avatar">

                        A

                    </div>


                    <div class="profile-info">

                        <strong>
                            Administrator
                        </strong>

                        <small>
                            CareLink360 Admin
                        </small>

                    </div>


                </div>


            </div>


        </header>



        <!-- =================================================
             PAGE CONTENT
        ================================================== -->

        <section class="content">


            <!-- BACK BUTTON -->

            <div class="back-button">

                <button type="button"
                        class="btn btn-outline-secondary btn-sm"
                        onclick="history.back()">

                    <i class="fa-solid fa-arrow-left"></i>

                    Back

                </button>

            </div>


            <!-- VIEW CONTENT -->

            @RenderBody()


        </section>



        <!-- =================================================
             FOOTER
        ================================================== -->

        <footer class="footer">

            © @DateTime.Now.Year CareLink360.

            All rights reserved.

        </footer>


    </main>



    <!-- =====================================================
         JAVASCRIPT
    ====================================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>


    @await RenderSectionAsync("Scripts", required: false)


</body>

</html>