@model List<CareLink360.Domain.Entities.Contract>
@{
    ViewData["Title"] = "Contracts";
    Layout = "_AdminLayout";
}

<div class="dashboard-card mb-3">
    <h5>Contracts</h5>
    <p class="subtitle mb-0">Active and past care arrangements</p>
</div>

<div class="dashboard-table">
    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <i class="fa-solid fa-inbox"></i>
            No contracts yet.
        </div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Client</th>
                    <th>Caregiver</th>
                    <th>Status</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var contract in Model)
                {
                    <tr>
                        <td>
                            <div class="person-cell">
                                <div class="person-avatar">@contract.Client.FirstName.Substring(0, 1)@contract.Client.LastName.Substring(0, 1)</div>
                                <div>
                                    <div class="person-name">@contract.Client.FirstName @contract.Client.LastName</div>
                                    <div class="person-sub">@contract.Client.City</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="person-cell">
                                <div class="person-avatar">@contract.Caregiver.FirstName.Substring(0, 1)@contract.Caregiver.LastName.Substring(0, 1)</div>
                                <div>
                                    <div class="person-name">@contract.Caregiver.FirstName @contract.Caregiver.LastName</div>
                                    <div class="person-sub">@contract.Caregiver.Skills</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="status-badge status-@contract.Status">@contract.Status</span>
                        </td>
                        <td>@contract.StartDate.ToString("MMM dd, yyyy")</td>
                        <td>
                            @(contract.EndDate == default ? "—" : contract.EndDate.ToString("MMM dd, yyyy"))
                        </td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@contract.Id" class="btn btn-sm btn-carelink">
                                View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>