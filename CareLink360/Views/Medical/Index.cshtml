@model IEnumerable<CareLink360.Domain.Entities.MedicalRecord>

@{
    ViewData["Title"] = "Medical Records";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between mb-3">

        <h2>Medical Records</h2>

        <a asp-action="Create"
           class="btn btn-primary">
            Add Medical Record
        </a>

    </div>

    <table class="table table-bordered table-hover shadow">

        <thead class="table-dark">

            <tr>

                <th>Caregiver ID</th>

                <th>Blood Group</th>

                <th>Vaccination</th>

                <th>Clearance</th>

                <th>Last Checkup</th>

                <th width="220">Action</th>

            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.CaregiverId</td>

                    <td>@item.BloodGroup</td>

                    <td>@item.VaccinationStatus</td>

                    <td>

                        @if (item.ClearanceStatus == "Approved")
                        {
                            <span class="badge bg-success">
                                Approved
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-warning">
                                @item.ClearanceStatus
                            </span>
                        }

                    </td>

                    <td>@item.LastCheckupDate.ToShortDateString()</td>

                    <td>

                        <a asp-action="Details"
                           asp-route-id="@item.Id"
                           class="btn btn-info btn-sm">
                            Details
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@item.Id"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@item.Id"
                           class="btn btn-danger btn-sm">
                            Delete
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>