@model CareLink360.Domain.Entities.NinVerification

@{
    ViewData["Title"] = "NIN Details";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-info text-white">

            <h3>NIN Verification Details</h3>

        </div>

        <div class="card-body">

            <table class="table">

                <tr>

                    <th>User ID</th>

                    <td>@Model.UserId</td>

                </tr>

                <tr>

                    <th>NIN</th>

                    <td>@Model.Nin</td>

                </tr>

                <tr>

                    <th>Status</th>

                    <td>@Model.Status</td>

                </tr>

                <tr>

                    <th>Verified</th>

                    <td>@Model.IsVerified</td>

                </tr>

                <tr>

                    <th>Submitted</th>

                    <td>@Model.SubmittedAt.ToString("dd MMM yyyy")</td>

                </tr>

            </table>

            <a asp-action="Index"
               class="btn btn-secondary">

                Back

            </a>

        </div>

    </div>

</div>