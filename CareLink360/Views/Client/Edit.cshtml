@model CareLink360.Application.DTOs.UpdateClientDto

@{
    ViewData["Title"] = "Edit Client";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>
    .edit-client-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }

    .edit-client-card {
        width: 100%;
        max-width: 620px;
        border: none;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.12);
    }

    .edit-client-header {
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
        color: #fff;
        padding: 2rem 2rem 1.5rem;
    }

        .edit-client-header h3 {
            font-weight: 700;
            margin-bottom: .25rem;
        }

        .edit-client-header p {
            opacity: .85;
            margin-bottom: 0;
            font-size: .9rem;
        }

    .edit-client-body {
        padding: 2rem;
        background: #fff;
    }

    .form-floating > label {
        color: #6c757d;
    }

    .form-control {
        border-radius: 12px;
        border: 1.5px solid #e5e7eb;
        padding: .9rem 1rem;
    }

        .form-control:focus {
            border-color: #6a11cb;
            box-shadow: 0 0 0 .2rem rgba(106, 17, 203, .15);
        }

    .form-floating textarea.form-control {
        min-height: 110px;
    }

    .field-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    .btn-gradient {
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
        border: none;
        color: #fff;
        border-radius: 12px;
        padding: .75rem 1.75rem;
        font-weight: 600;
    }

        .btn-gradient:hover {
            color: #fff;
            filter: brightness(.95);
        }

    .btn-outline-cancel {
        border-radius: 12px;
        padding: .75rem 1.75rem;
        font-weight: 600;
        border: 1.5px solid #e5e7eb;
        color: #6c757d;
    }

    .form-actions {
        display: flex;
        gap: .75rem;
        margin-top: 1.5rem;
    }

    @@media (max-width: 576px) {
        .field-row {
            grid-template-columns: 1fr;
        }

        .edit-client-body {
            padding: 1.25rem;
        }

        .form-actions {
            flex-direction: column;
        }
    }
</style>

<div class="edit-client-wrapper">
    <div class="card edit-client-card">

        <div class="edit-client-header">
            <h3>
                <i class="bi bi-person-lines-fill me-2"></i>
                Edit Client
            </h3>
            <p>Update the client's contact and address details.</p>
        </div>

        <div class="edit-client-body">

            <form asp-controller="Client"
                  asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()

                @* Pass the same ID used to load the client. *@
                <input type="hidden" name="id" value="@ViewContext.RouteData.Values["id"]" />

                <div asp-validation-summary="All"
                     class="text-danger mb-3"></div>

                <div class="field-row mb-3">

                    <div class="form-floating">
                        <input asp-for="FirstName"
                               class="form-control"
                               placeholder="First name" />
                        <label asp-for="FirstName">
                            <i class="bi bi-person me-1"></i>
                            First Name
                        </label>
                        <span asp-validation-for="FirstName"
                              class="text-danger"></span>
                    </div>

                    <div class="form-floating">
                        <input asp-for="LastName"
                               class="form-control"
                               placeholder="Last name" />
                        <label asp-for="LastName">
                            <i class="bi bi-person me-1"></i>
                            Last Name
                        </label>
                        <span asp-validation-for="LastName"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="form-floating mb-3">
                    <input asp-for="PhoneNumber"
                           class="form-control"
                           placeholder="Phone number" />
                    <label asp-for="PhoneNumber">
                        <i class="bi bi-telephone me-1"></i>
                        Phone Number
                    </label>
                    <span asp-validation-for="PhoneNumber"
                          class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="City"
                           class="form-control"
                           placeholder="City" />
                    <label asp-for="City">
                        <i class="bi bi-geo-alt me-1"></i>
                        City
                    </label>
                    <span asp-validation-for="City"
                          class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <textarea asp-for="Address"
                              class="form-control"
                              placeholder="Address"></textarea>
                    <label asp-for="Address">
                        <i class="bi bi-house-door me-1"></i>
                        Home Address
                    </label>
                    <span asp-validation-for="Address"
                          class="text-danger"></span>
                </div>

                <div class="form-actions">

                    <button type="submit"
                            class="btn btn-gradient flex-grow-1">
                        <i class="bi bi-check2-circle me-1"></i>
                        Update Client
                    </button>

                    <a asp-controller="Client"
                       asp-action="Index"
                       class="btn btn-outline-cancel">
                        <i class="bi bi-x-circle me-1"></i>
                        Cancel
                    </a>

                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
