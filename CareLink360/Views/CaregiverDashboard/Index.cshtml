@model CareLink360.Application.DTOs.CaregiverResponseDto

@{
    ViewData["Title"] = "My Dashboard";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold">
                Welcome, @Model.FirstName
            </h1>

            <p class="text-muted">
                Welcome to your CareLink360 caregiver dashboard.
            </p>
        </div>

        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-secondary">
            ← Back
        </a>

    </div>

    <div class="row g-4">

        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h5 class="fw-bold">
                        My Profile
                    </h5>

                    <hr />

                    <p>
                        <strong>Name:</strong>
                        @Model.FirstName @Model.LastName
                    </p>

                    <p>
                        <strong>Phone:</strong>
                        @Model.PhoneNumber
                    </p>

                    <p>
                        <strong>City:</strong>
                        @Model.City
                    </p>

                    <p>
                        <strong>Experience:</strong>
                        @Model.YearsOfExperience years
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h5 class="fw-bold">
                        Verification
                    </h5>

                    <hr />

                    <p>
                        NIN Verification:

                        @if (Model.IsNinVerified)
                        {
                                <span class="badge bg-success">
                                    Verified
                                </span>
                        }
                        else
                        {
                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>
                        }
                    </p>

                    <p>
                        Admin Approval:

                        @if (Model.IsApprovedByAdmin)
                        {
                                <span class="badge bg-success">
                                    Approved
                                </span>
                        }
                        else
                        {
                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>
                        }
                    </p>

                </div>

            </div>

        </div>


        <div class="col-md-4">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h5 class="fw-bold">
                        Availability
                    </h5>

                    <hr />

                    @if (Model.IsAvaliable)
                    {
                            <span class="badge bg-success fs-6">
                                Available for Work
                            </span>
                    }
                    else
                    {
                            <span class="badge bg-secondary fs-6">
                                Currently Unavailable
                            </span>
                    }

                    <div class="mt-4">

                        <strong>Average Rating</strong>

                        <h2>
                            @Model.AverageRating.ToString("0.0") / 5
                        </h2>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>