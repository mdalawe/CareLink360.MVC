@model List<CareLink360.Domain.Entities.Payment>
@{
    ViewData["Title"] = "Payments";
    Layout = "_AdminLayout";
}

<div class="dashboard-card mb-3">
    <h5>Payments</h5>
    <p class="subtitle mb-0">All payments recorded across contracts</p>
</div>

<div class="dashboard-table">
    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <i class="fa-solid fa-inbox"></i>
            No payments recorded yet.
        </div>
    }
    else
    {
        <table class="table">
            <thead>
                <tr>
                    <th>Client</th>
                    <th>Method</th>
                    <th>Amount</th>
                    <th>Status</th>
                    <th>Date</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var payment in Model)
                {
                    <tr>
                        <td>
                            <div class="person-cell">
                                <div class="person-avatar">@payment.Client.FirstName.Substring(0, 1)@payment.Client.LastName.Substring(0, 1)</div>
                                <div>
                                    <div class="person-name">@payment.Client.FirstName @payment.Client.LastName</div>
                                </div>
                            </div>
                        </td>
                        <td>@payment.PaymentMethod</td>
                        <td>₦@payment.Amount.ToString("N2")</td>
                        <td>
                            <span class="status-badge status-@payment.Status">@payment.Status</span>
                        </td>
                        <td>@payment.PaymentDate.ToString("MMM dd, yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@payment.Id" class="btn btn-sm btn-carelink">
                                View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>