@model CareLink360.Web.Models.RegisterViewModel

@{
    Layout = null;
    ViewData["Title"] = "Register";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Register - CareLink360</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f4f8fb;
            color: #263238;
            min-height: 100vh;
        }

        .register-wrapper {
            min-height: calc(100vh - 60px);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 35px 20px;
        }

        .register-container {
            display: grid;
            grid-template-columns: 0.9fr 1.1fr;
            width: 100%;
            max-width: 1000px;
            background: #ffffff;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 12px 40px rgba(20, 60, 80, 0.12);
        }

        .welcome-panel {
            background: linear-gradient(135deg, #087f8c, #075985);
            color: #ffffff;
            padding: 45px 35px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .welcome-tag {
            display: inline-block;
            align-self: flex-start;
            background: rgba(255, 255, 255, 0.16);
            padding: 9px 14px;
            border-radius: 30px;
            font-size: 12px;
            font-weight: bold;
            letter-spacing: 1px;
            margin-bottom: 25px;
        }

        .welcome-panel h1 {
            font-size: 34px;
            line-height: 1.3;
            margin-bottom: 20px;
        }

        .welcome-panel p {
            font-size: 15px;
            line-height: 1.8;
            color: #e0f2fe;
        }

        .register-form-panel {
            padding: 40px;
        }

            .register-form-panel h2 {
                font-size: 29px;
                color: #075985;
                margin-bottom: 10px;
            }

        .form-subtitle {
            color: #718096;
            font-size: 14px;
            margin-bottom: 25px;
        }

        .form-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 0 16px;
        }

        .form-group {
            margin-bottom: 17px;
        }

            .form-group.full-width {
                grid-column: 1 / -1;
            }

            .form-group label {
                display: block;
                font-weight: 600;
                font-size: 14px;
                margin-bottom: 8px;
                color: #374151;
            }

        .form-control {
            width: 100%;
            padding: 12px 13px;
            border: 1px solid #d5dee7;
            border-radius: 8px;
            font-size: 14px;
            outline: none;
            background: #ffffff;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .form-control:focus {
                border-color: #0891b2;
                box-shadow: 0 0 0 3px rgba(8, 145, 178, 0.12);
            }

        .validation-message {
            display: block;
            color: #dc2626;
            font-size: 12px;
            margin-top: 5px;
        }

        .validation-summary {
            color: #dc2626;
            font-size: 14px;
            margin-bottom: 15px;
        }

        .register-button {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 8px;
            background: #087f8c;
            color: #ffffff;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            margin-top: 5px;
            transition: background 0.2s, transform 0.2s;
        }

            .register-button:hover {
                background: #066773;
                transform: translateY(-1px);
            }

        .login-link {
            text-align: center;
            margin-top: 22px;
            font-size: 14px;
            color: #64748b;
        }

            .login-link a {
                color: #087f8c;
                text-decoration: none;
                font-weight: bold;
            }

                .login-link a:hover {
                    text-decoration: underline;
                }

        .page-footer {
            min-height: 60px;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 15px;
            text-align: center;
            color: #718096;
            font-size: 13px;
        }

        @@media (max-width: 800px) {
            .register-container {
                grid-template-columns: 1fr;
                max-width: 600px;
            }

            .welcome-panel {
                padding: 30px;
            }

                .welcome-panel h1 {
                    font-size: 28px;
                }

            .register-form-panel {
                padding: 30px;
            }
        }

        @@media (max-width: 480px) {
            .register-wrapper {
                padding: 20px 12px;
            }

            .form-grid {
                grid-template-columns: 1fr;
            }

            .form-group.full-width {
                grid-column: auto;
            }

            .welcome-panel,
            .register-form-panel {
                padding: 25px 20px;
            }
        }
    </style>
</head>

<body>
    <main class="register-wrapper">
        <div class="register-container">

            <section class="welcome-panel">
                <span class="welcome-tag">COMPASSIONATE CARE. EVERY TIME.</span>

                <h1>Join CareLink360</h1>

                <p>
                    Create your account to connect with caregivers and
                    families. We make finding and managing compassionate
                    care easier.
                </p>
            </section>

            <section class="register-form-panel">
                <h2>Create Account</h2>

                <p class="form-subtitle">
                    Fill in your details to get started.
                </p>

                <form asp-controller="Auth" asp-action="Register" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary"></div>

                    <div class="form-grid">

                        <div class="form-group">
                            <label asp-for="FirstName">First Name</label>

                            <input asp-for="FirstName"
                                   class="form-control"
                                   placeholder="First name"
                                   autocomplete="given-name" />

                            <span asp-validation-for="FirstName"
                                  class="validation-message"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="LastName">Last Name</label>

                            <input asp-for="LastName"
                                   class="form-control"
                                   placeholder="Last name"
                                   autocomplete="family-name" />

                            <span asp-validation-for="LastName"
                                  class="validation-message"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Email">Email Address</label>

                            <input asp-for="Email"
                                   class="form-control"
                                   type="email"
                                   placeholder="Email address"
                                   autocomplete="email" />

                            <span asp-validation-for="Email"
                                  class="validation-message"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="PhoneNumber">Phone Number</label>

                            <input asp-for="PhoneNumber"
                                   class="form-control"
                                   type="tel"
                                   placeholder="Phone number"
                                   autocomplete="tel" />

                            <span asp-validation-for="PhoneNumber"
                                  class="validation-message"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Password">Password</label>

                            <input asp-for="Password"
                                   class="form-control"
                                   type="password"
                                   placeholder="Create password"
                                   autocomplete="new-password" />

                            <span asp-validation-for="Password"
                                  class="validation-message"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="ConfirmPassword">
                                Confirm Password
                            </label>

                            <input asp-for="ConfirmPassword"
                                   class="form-control"
                                   type="password"
                                   placeholder="Confirm password"
                                   autocomplete="new-password" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="validation-message"></span>
                        </div>

                        <div class="form-group full-width">
                            <label asp-for="Role">Register As</label>

                            <select asp-for="Role" class="form-control">
                                <option value="">Select your role</option>
                                <option value="Client">Client / Parent</option>
                                <option value="Caregiver">Caregiver</option>
                            </select>

                            <span asp-validation-for="Role"
                                  class="validation-message"></span>
                        </div>

                    </div>

                    <button type="submit" class="register-button">
                        Create Account
                    </button>

                    <div class="login-link">
                        Already have an account?
                        <a asp-controller="Auth" asp-action="Login">
                            Sign in
                        </a>
                    </div>
                </form>
            </section>

        </div>
    </main>

    <footer class="page-footer">
        &copy; @DateTime.Now.Year CareLink360. All rights reserved.
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>