@model IEnumerable<CareLink360.Web.Models.JobRequestViewModel>

@{
    ViewData["Title"] = "Job Requests";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Job Requests</h2>
            <p class="text-muted">
                Manage caregiver job requests
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-primary">
            + New Job Request
        </a>

    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">

            <table class="table table-striped table-bordered shadow-sm">

                <thead class="table-dark">

                    <tr>
                        <th>Client</th>
                        <th>Job Type</th>
                        <th>Location</th>
                        <th>Preferred Date</th>
                        <th>Status</th>
                        <th width="250">Action</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.ClientName
                            </td>

                            <td>
                                @item.JobType
                            </td>

                            <td>
                                @item.Location
                            </td>

                            <td>
                                @item.PreferredDate.ToString("dd MMM yyyy")
                            </td>

                            <td>

                                @if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                                else if (item.Status == "Approved")
                                {
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                }
                                else if (item.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        @item.Status
                                    </span>
                                }

                            </td>

                            <td>

                                <a asp-action="Details"
                                   asp-route-id="@item.Id"
                                   class="btn btn-info btn-sm">
                                    Details
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@item.Id"
                                   class="btn btn-danger btn-sm">
                                    Delete
                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="alert alert-info text-center">

            <h5>No Job Requests Found</h5>

            <p>
                There are currently no job requests.
            </p>

            <a asp-action="Create"
               class="btn btn-primary">
                Create First Job Request
            </a>

        </div>
    }

</div>