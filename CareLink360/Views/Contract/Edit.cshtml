@model CareLink360.Application.DTOs.UpdateContractStatusDto
@using CareLink360.Domain.Enums
@{
    ViewData["Title"] = "Update Contract Status";
    Layout = "_AdminLayout";
}

<div class="dashboard-card" style="max-width: 520px;">
    <h5><i class="fa-solid fa-arrows-rotate me-2"></i>Update Contract Status</h5>
    <p class="subtitle">Change the current status of this contract</p>

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    <form asp-action="UpdateStatus" method="post">

        <input type="hidden" asp-for="ContractId" />

        <div class="mb-3">
            <label asp-for="Status" class="form-label">Status</label>
            <select asp-for="Status"
                    asp-items="Html.GetEnumSelectList<ContractStatus>()"
                    class="form-select">
            </select>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-carelink flex-grow-1">
                <i class="fa-solid fa-check me-1"></i> Update Status
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary">
                Cancel
            </a>
        </div>
    </form>
</div>