@model CareLink360.Application.DTOs.CaregiverResponseDto

@{
    ViewData["Title"] = "Caregiver Details";
}

<div class="container py-4">

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1">
                Caregiver Details
            </h2>

            <p class="text-muted mb-0">
                View caregiver information and current status
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left"></i>
            Back to Caregivers

        </a>

    </div>


    <!-- =====================================================
         CAREGIVER CARD
    ====================================================== -->

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">


            <!-- CAREGIVER NAME -->

            <div class="d-flex align-items-center mb-4">

                <div class="rounded-circle bg-success-subtle
                            text-success d-flex align-items-center
                            justify-content-center me-3"
                     style="width:60px;height:60px;font-weight:bold;font-size:18px;">

                    @(
                        (!string.IsNullOrWhiteSpace(Model.FirstName)
                        ? Model.FirstName.Substring(0, 1)
                        : "") +
                        (!string.IsNullOrWhiteSpace(Model.LastName)
                        ? Model.LastName.Substring(0, 1)
                        : "")
                        )

                </div>

                <div>

                    <h3 class="fw-bold mb-1">

                        @Model.FirstName
                        @Model.LastName

                    </h3>

                    <span class="text-muted">
                        Caregiver
                    </span>

                </div>

            </div>


            <hr />


            <!-- =================================================
                 INFORMATION
            ================================================== -->

            <div class="row g-4 mt-2">


                <!-- PHONE -->

                <div class="col-md-6">

                    <div class="text-muted small mb-1">
                        <i class="bi bi-telephone me-1"></i>
                        Phone Number
                    </div>

                    <strong>
                        @Model.PhoneNumber
                    </strong>

                </div>


                <!-- CITY -->

                <div class="col-md-6">

                    <div class="text-muted small mb-1">
                        <i class="bi bi-geo-alt me-1"></i>
                        City
                    </div>

                    <strong>
                        @Model.City
                    </strong>

                </div>


                <!-- EXPERIENCE -->

                <div class="col-md-6">

                    <div class="text-muted small mb-1">
                        <i class="bi bi-briefcase me-1"></i>
                        Experience
                    </div>

                    <strong>
                        @Model.YearsOfExperience years
                    </strong>

                </div>


                <!-- RATING -->

                <div class="col-md-6">

                    <div class="text-muted small mb-1">
                        <i class="bi bi-star-fill me-1 text-warning"></i>
                        Rating
                    </div>

                    <strong>
                        @Model.AverageRating.ToString("0.0") / 5
                    </strong>

                </div>


                <!-- =================================================
                     AVAILABILITY
                ================================================== -->

                <div class="col-md-6">

                    <div class="text-muted small mb-1">
                        <i class="bi bi-circle-fill me-1"></i>
                        Availability
                    </div>

                    @if (Model.IsAvaliable)
                    {
                        <span class="badge bg-success">
                            <i class="bi bi-check-circle me-1"></i>
                            Available
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            <i class="bi bi-x-circle me-1"></i>
                            Unavailable
                        </span>
                    }

                </div>


                <!-- =================================================
                     ADMIN APPROVAL
                ================================================== -->

                <div class="col-md-6">

                    <div class="text-muted small mb-1">
                        <i class="bi bi-shield-check me-1"></i>
                        Admin Approval
                    </div>

                    @if (Model.IsApprovedByAdmin)
                    {
                        <span class="badge bg-success">

                            <i class="bi bi-patch-check-fill me-1"></i>

                            Approved

                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">

                            <i class="bi bi-hourglass-split me-1"></i>

                            Pending Approval

                        </span>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         ACTIONS
    ====================================================== -->

    <div class="mt-4 d-flex gap-2">

        <a asp-action="Index"
           class="btn btn-secondary">

            <i class="bi bi-arrow-left"></i>

            Back

        </a>


        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-primary">

            <i class="bi bi-pencil"></i>

            Edit Caregiver

        </a>

    </div>

</div>


<!-- =========================================================
     BOOTSTRAP ICONS
========================================================= -->

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"