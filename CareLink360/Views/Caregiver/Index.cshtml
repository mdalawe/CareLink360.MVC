        }

    @@media (max-width: 767px) {
        .page-header {
            align-items: flex-start;
        }

        .page-title {
            font-size: 23px;
        }

        .create-btn {
            width: 100%;
        }

        .stat-card {
            padding: 17px;
        }

        .card-heading, .filter-panel {
            padding: 18px;
        }

        .filter-footer {
            align-items: flex-start;
        }

        .status-form {
            width: 130px;
        }
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchInput = document.getElementById("caregiverSearch");
            const availabilityFilter = document.getElementById("availabilityFilter");
            const cityFilter = document.getElementById("cityFilter");
            const resetButton = document.getElementById("resetFilters");
            const resultCount = document.getElementById("resultCount");
            const noFilterResults = document.getElementById("noFilterResults");

            const rows = Array.from(
                document.querySelectorAll(".caregiver-row")
            );

            function applyFilters() {
                const searchText =
                    (searchInput.value || "").trim().toLowerCase();

                const selectedAvailability = availabilityFilter.value;
                const selectedCity =
                    (cityFilter.value || "all").trim().toLowerCase();

                let visibleCount = 0;

                rows.forEach(function (row) {
                    const name = row.dataset.name || "";
                    const phone = row.dataset.phone || "";
                    const city = row.dataset.city || "";
                    const available = row.dataset.available || "";

                    const matchesSearch =
                        name.includes(searchText) ||
                        phone.includes(searchText) ||
                        city.includes(searchText);

                    const matchesAvailability =
                        selectedAvailability === "all" ||
                        available === selectedAvailability;

                    const matchesCity =
                        selectedCity === "all" ||
                        city === selectedCity;

                    const showRow =
                        matchesSearch && matchesAvailability && matchesCity;

                    row.style.display = showRow ? "" : "none";

                    if (showRow) visibleCount++;
                });

                resultCount.textContent =
                    "Showing " + visibleCount +
                    " of " + rows.length + " caregiver(s)";

                if (noFilterResults) {
                    noFilterResults.style.display =
                        rows.length > 0 && visibleCount === 0 ? "" : "none";
                }
            }

            searchInput.addEventListener("input", applyFilters);
            availabilityFilter.addEventListener("change", applyFilters);
            cityFilter.addEventListener("change", applyFilters);

            resetButton.addEventListener("click", function () {
                searchInput.value = "";
                availabilityFilter.value = "all";
                cityFilter.value = "all";
                applyFilters();
            });

            applyFilters();
        });
    </script>
}
