@model CareLink360.Web.Models.LoginViewModel

@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - CareLink360</title>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f4f8fb;
            color: #263238;
            min-height: 100vh;
        }

        .login-wrapper {
            min-height: calc(100vh - 60px);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 35px 20px;
        }

        .login-container {
            display: grid;
            grid-template-columns: 1fr 1fr;
            width: 100%;
            max-width: 950px;
            min-height: 540px;
            background: #ffffff;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 12px 40px rgba(20, 60, 80, 0.12);
        }

        .welcome-panel {
            background: linear-gradient(135deg, #087f8c, #075985);
            color: #ffffff;
            padding: 55px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .welcome-panel h1 {
                font-size: 36px;
                line-height: 1.3;
                margin-bottom: 20px;
            }

            .welcome-panel p {
                font-size: 16px;
                line-height: 1.8;
                color: #e0f2fe;
            }

        .welcome-tag {
            display: inline-block;
            align-self: flex-start;
            background: rgba(255, 255, 255, 0.16);
            padding: 9px 14px;
            border-radius: 30px;
            font-size: 12px;
            font-weight: bold;
            letter-spacing: 1px;
            margin-bottom: 25px;
        }

        .login-form-panel {
            padding: 50px 42px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

            .login-form-panel h2 {
                font-size: 30px;
                color: #075985;
                margin-bottom: 10px;
            }

        .form-subtitle {
            color: #718096;
            font-size: 14px;
            margin-bottom: 30px;
        }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group label {
                display: block;
                font-weight: 600;
                font-size: 14px;
                margin-bottom: 8px;
                color: #374151;
            }

        .form-control {
            width: 100%;
            padding: 13px 14px;
            border: 1px solid #d5dee7;
            border-radius: 8px;
            font-size: 15px;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

            .form-control:focus {
                border-color: #0891b2;
                box-shadow: 0 0 0 3px rgba(8, 145, 178, 0.12);
            }

        .validation-message {
            display: block;
            color: #dc2626;
            font-size: 13px;
            margin-top: 6px;
        }

        .validation-summary {
            color: #dc2626;
            font-size: 14px;
            margin-bottom: 15px;
        }

        .remember-row {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 24px;
            font-size: 14px;
            color: #4b5563;
        }

            .remember-row input {
                width: 16px;
                height: 16px;
                accent-color: #087f8c;
            }

        .login-button {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 8px;
            background: #087f8c;
            color: #ffffff;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.2s, transform 0.2s;
        }

            .login-button:hover {
                background: #066773;
                transform: translateY(-1px);
            }

        .register-link {
            text-align: center;
            margin-top: 25px;
            font-size: 14px;
            color: #64748b;
        }

            .register-link a {
                color: #087f8c;
                text-decoration: none;
                font-weight: bold;
            }

                .register-link a:hover {
                    text-decoration: underline;
                }

        .page-footer {
            min-height: 60px;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 15px;
            text-align: center;
            color: #718096;
            font-size: 13px;
        }

        @@media (max-width: 768px) {
            .login-container {
                grid-template-columns: 1fr;
                max-width: 500px;
            }

            .welcome-panel {
                padding: 35px 30px;
            }

                .welcome-panel h1 {
                    font-size: 28px;
                }

            .login-form-panel {
                padding: 35px 30px;
            }
        }

        @@media (max-width: 480px) {
            .login-wrapper {
                padding: 20px 12px;
            }

            .welcome-panel,
            .login-form-panel {
                padding: 28px 22px;
            }

                .login-form-panel h2 {
                    font-size: 26px;
                }
        }
    </style>
</head>

<body>
    <main class="login-wrapper">
        <div class="login-container">

            <section class="welcome-panel">
                <span class="welcome-tag">COMPASSIONATE CARE. EVERY TIME.</span>

                <h1>Welcome Back to CareLink360</h1>

                <p>
                    Sign in to connect with trusted caregivers, manage care
                    requests, and stay connected with the people who matter.
                </p>
            </section>

            <section class="login-form-panel">
                <h2>Sign In</h2>

                <p class="form-subtitle">
                    Enter your account details to continue.
                </p>

                <form asp-controller="Auth" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="validation-summary"></div>

                    <div class="form-group">
                        <label asp-for="Email">Email Address</label>

                        <input asp-for="Email"
                               class="form-control"
                               type="email"
                               placeholder="Enter your email"
                               autocomplete="email" />

                        <span asp-validation-for="Email"
                              class="validation-message"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Password">Password</label>

                        <input asp-for="Password"
                               class="form-control"
                               type="password"
                               placeholder="Enter your password"
                               autocomplete="current-password" />

                        <span asp-validation-for="Password"
                              class="validation-message"></span>
                    </div>

                    <div class="remember-row">
                        <input asp-for="RememberMe" />
                        <label asp-for="RememberMe">Remember me</label>
                    </div>

                    <button type="submit" class="login-button">
                        Sign In
                    </button>

                    <div class="register-link">
                        Don't have an account?
                        <a asp-controller="Auth" asp-action="Register">
                            Create an account
                        </a>
                    </div>
                </form>
            </section>

        </div>
    </main>

    <footer class="page-footer">
        &copy; @DateTime.Now.Year CareLink360. All rights reserved.
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>