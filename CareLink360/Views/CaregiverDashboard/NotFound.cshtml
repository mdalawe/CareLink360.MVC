@{
    ViewData["Title"] = "Profile Not Found";
}

<div class="container py-5">

    <div class="card shadow-sm border-0 text-center p-5">

        <div class="mb-3">
            <span style="font-size: 60px;">⚠️</span>
        </div>

        <h2 class="fw-bold">
            Caregiver Profile Not Found
        </h2>

        <p class="text-muted">
            Your caregiver account exists, but we could not find
            a caregiver profile connected to your account.
        </p>

        <div class="mt-3">

            <a asp-controller="Auth"
               asp-action="Login"
               class="btn btn-primary">
                Back to Login
            </a>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Back to Home
            </a>

        </div>

    </div>

</div>