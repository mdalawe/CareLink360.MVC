@model CareLink360.Application.DTOs.CreateClientDto
@{
    ViewData["Title"] = "Edit Client";
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

<style>
    .edit-client-wrapper {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
    }

    .edit-client-card {
        width: 100%;
        max-width: 620px;
        border: none;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 20px 45px rgba(0, 0, 0, 0.12);
        animation: fadeSlideUp 0.4s ease-out;
    }

    @@keyframes fadeSlideUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .edit-client-header {
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
        color: #fff;
        padding: 2rem 2rem 1.5rem;
        border: none;
    }

    .edit-client-header h3 {
        font-weight: 700;
        margin-bottom: 0.25rem;
    }

    .edit-client-header p {
        opacity: 0.85;
        margin-bottom: 0;
        font-size: 0.9rem;
    }

    .edit-client-body {
        padding: 2rem;
        background: #fff;
    }

    .form-floating > label {
        color: #6c757d;
    }

    .form-control {
        border-radius: 12px;
        border: 1.5px solid #e5e7eb;
        padding: 0.9rem 1rem;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .form-control:focus {
        border-color: #6a11cb;
        box-shadow: 0 0 0 0.2rem rgba(106, 17, 203, 0.15);
    }

    .form-floating textarea.form-control {
        min-height: 100px;
    }

    .field-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 1rem;
    }

    @@media (max-width: 576px) {
        .field-row {
            grid-template-columns: 1fr;
        }
    }

    .btn-gradient {
        background: linear-gradient(135deg, #6a11cb 0%, #2575fc 100%);
        border: none;
        color: #fff;
        border-radius: 12px;
        padding: 0.75rem 1.75rem;
        font-weight: 600;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
    }

    .btn-gradient:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(106, 17, 203, 0.3);
        color: #fff;
    }

    .btn-outline-cancel {
        border-radius: 12px;
        padding: 0.75rem 1.75rem;
        font-weight: 600;
        border: 1.5px solid #e5e7eb;
        color: #6c757d;
        transition: all 0.15s ease;
    }

    .btn-outline-cancel:hover {
        background: #f8f9fa;
        color: #343a40;
        border-color: #d1d5db;
    }

    .form-actions {
        display: flex;
        gap: 0.75rem;
        margin-top: 1.5rem;
    }
</style>

<div class="edit-client-wrapper">
    <div class="card edit-client-card">
        <div class="edit-client-header">
            <h3><i class="bi bi-person-lines-fill me-2"></i>Edit Client</h3>
            <p>Update the client's contact and address details</p>
        </div>
        <div class="edit-client-body">
            <form asp-action="Edit">
                <div class="field-row mb-3">
                    <div class="form-floating">
                        <input asp-for="FirstName" class="form-control" placeholder="First name" />
                        <label asp-for="FirstName"><i class="bi bi-person me-1"></i>First Name</label>
                    </div>
                    <div class="form-floating">
                        <input asp-for="LastName" class="form-control" placeholder="Last name" />
                        <label asp-for="LastName"><i class="bi bi-person me-1"></i>Last Name</label>
                    </div>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="PhoneNumber" class="form-control" placeholder="Phone number" />
                    <label asp-for="PhoneNumber"><i class="bi bi-telephone me-1"></i>Phone Number</label>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="City" class="form-control" placeholder="City" />
                    <label asp-for="City"><i class="bi bi-geo-alt me-1"></i>City</label>
                </div>

                <div class="form-floating mb-3">
                    <textarea asp-for="Address" class="form-control" placeholder="Address"></textarea>
                    <label asp-for="Address"><i class="bi bi-house-door me-1"></i>Address</label>
                </div>

                <div class="form-actions">
                    <button class="btn btn-gradient flex-grow-1">
                        <i class="bi bi-check2-circle me-1"></i> Update Client
                    </button>
                    <a asp-action="Index" class="btn btn-outline-cancel">
                        <i class="bi bi-x-circle me-1"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>