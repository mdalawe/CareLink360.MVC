@model IEnumerable<CareLink360.Application.DTOs.CaregiverResponseDto>

@{
    ViewData["Title"] = "Caregiver Management";
    Layout = "_AdminLayout";

    var caregivers = Model?.ToList()
        ?? new List<CareLink360.Application.DTOs.CaregiverResponseDto>();

    var totalCaregivers = caregivers.Count;
    var availableCaregivers = caregivers.Count(c => c.IsAvaliable);
    var pendingCaregivers = caregivers.Count(c => !c.IsApprovedByAdmin);
    var approvedCaregivers = caregivers.Count(c => c.IsApprovedByAdmin);
}

<div class="container-fluid caregiver-page py-4">

    <div class="page-header mb-4">
        <div>
            <span class="page-eyebrow">
                <i class="bi bi-heart-pulse me-1"></i>
                CARELINK360 ADMINISTRATION
            </span>
            <h2 class="page-title">Caregiver Management</h2>
            <p class="page-subtitle">
                Manage caregivers, monitor availability, and review approval status.
            </p>
        </div>

        <a asp-controller="Caregiver"
           asp-action="Create"
           class="btn btn-primary create-btn">
            <i class="bi bi-person-plus me-2"></i>
            Add Caregiver
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["Success"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["Error"]
            <button type="button" class="btn-close"
                    data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- STATISTICS -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon stat-icon-blue">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <p class="stat-label">Total Caregivers</p>
                    <h3 class="stat-number">@totalCaregivers</h3>
                    <span class="stat-description">Registered caregivers</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon stat-icon-green">
                    <i class="bi bi-person-check-fill"></i>
                </div>
                <div>
                    <p class="stat-label">Available</p>
                    <h3 class="stat-number">@availableCaregivers</h3>
                    <span class="stat-description">Marked as available</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon stat-icon-orange">
                    <i class="bi bi-hourglass-split"></i>
                </div>
                <div>
                    <p class="stat-label">Pending Approval</p>
                    <h3 class="stat-number">@pendingCaregivers</h3>
                    <span class="stat-description">Awaiting admin approval</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="stat-card">
                <div class="stat-icon stat-icon-purple">
                    <i class="bi bi-patch-check-fill"></i>
                </div>
                <div>
                    <p class="stat-label">Approved</p>
                    <h3 class="stat-number">@approvedCaregivers</h3>
                    <span class="stat-description">Approved by admin</span>
                </div>
            </div>
        </div>
    </div>

    <!-- CAREGIVER MANAGEMENT TABLE -->
    <div class="caregiver-card">

        <div class="card-heading">
            <div>
                <h4>
                    <i class="bi bi-person-lines-fill me-2"></i>
                    All Caregivers
                </h4>
                <p>View and manage registered caregiver profiles.</p>
            </div>

            <span class="total-badge">
                @totalCaregivers caregiver(s)
            </span>
        </div>

        <!-- SEARCH AND FILTERS -->
        <div class="filter-panel">
            <div class="row g-3">
                <div class="col-12 col-lg-5">
                    <label for="caregiverSearch" class="form-label">
                        Search caregivers
                    </label>
                    <div class="search-wrapper">
                        <i class="bi bi-search"></i>
                        <input id="caregiverSearch"
                               type="text"
                               class="form-control"
                               placeholder="Search by name, phone, or city..." />
                    </div>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <label for="availabilityFilter" class="form-label">
                        Availability
                    </label>
                    <select id="availabilityFilter" class="form-select">
                        <option value="all">All availability</option>
                        <option value="true">Available</option>
                        <option value="false">Unavailable</option>
                    </select>
                </div>

                <div class="col-12 col-md-6 col-lg-4">
                    <label for="cityFilter" class="form-label">City</label>
                    <select id="cityFilter" class="form-select">
                        <option value="all">All cities</option>
                        @foreach (var city in caregivers
                        .Where(c => !string.IsNullOrWhiteSpace(c.City))
                        .Select(c => c.City!.Trim())
                        .Distinct(StringComparer.OrdinalIgnoreCase)
                        .OrderBy(c => c))
                        {
                            <option value="@city">@city</option>
                        }
                    </select>
                </div>
            </div>

            <div class="filter-footer">
                <span id="resultCount">
                    Showing @totalCaregivers caregiver(s)
                </span>

                <button type="button"
                        id="resetFilters"
                        class="btn btn-light border">
                    <i class="bi bi-arrow-counterclockwise me-1"></i>
                    Reset filters
                </button>
            </div>
        </div>

        <!-- TABLE -->
        <div class="table-responsive">
            <table class="table caregiver-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Caregiver</th>
                        <th>Phone</th>
                        <th>City</th>
                        <th>Experience</th>
                        <th>Availability</th>
                        <th>Approval</th>
                        <th>Rating</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody id="caregiverTableBody">
                    @if (!caregivers.Any())
                    {
                        <tr>
                            <td colspan="8" class="empty-state">
                                <div class="empty-icon">
                                    <i class="bi bi-people"></i>
                                </div>
                                <h5>No caregivers found</h5>
                                <p>There are currently no caregivers to display.</p>
                                <a asp-controller="Caregiver"
                                   asp-action="Create"
                                   class="btn btn-primary">
                                    <i class="bi bi-person-plus me-1"></i>
                                    Add Caregiver
                                </a>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var caregiver in caregivers)
                        {
                            var fullName =
                            $"{caregiver.FirstName} {caregiver.LastName}".Trim();

                            <tr class="caregiver-row"
                                data-name="@fullName.ToLowerInvariant()"
                                data-phone="@((caregiver.PhoneNumber ?? "").ToLowerInvariant())"
                                data-city="@((caregiver.City ?? "").Trim().ToLowerInvariant())"
                                data-available="@caregiver.IsAvaliable.ToString().ToLowerInvariant()">

                                <td>
                                    <div class="caregiver-identity">
                                        <div class="avatar">
                                            <i class="bi bi-person-fill"></i>
                                        </div>
                                        <div>
                                            <div class="caregiver-name">@fullName</div>
                                            <div class="caregiver-subtitle">Caregiver</div>
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(caregiver.PhoneNumber)
                                        ? "Not provided"
                                        : caregiver.PhoneNumber)
                                </td>

                                <td>
                                    <span class="city-label">
                                        <i class="bi bi-geo-alt me-1"></i>
                                        @(string.IsNullOrWhiteSpace(caregiver.City)
                                            ? "Not provided"
                                            : caregiver.City)
                                    </span>
                                </td>

                                <td>
                                    <strong>@caregiver.YearsOfExperience</strong>
                                    <span class="experience-label">year(s)</span>
                                </td>

                                <!-- AVAILABILITY -->
                                <td>
                                    <form asp-controller="Caregiver"
                                          asp-action="SetAvailability"
                                          method="post"
                                          class="status-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@caregiver.Id" />

                                        <select name="isAvailable"
                                                class="form-select status-select @(caregiver.IsAvaliable ? "select-available" : "select-unavailable")"
                                                onchange="this.form.submit()"
                                                aria-label="Change caregiver availability">

                                            @if (caregiver.IsAvaliable)
                                            {
                                                <option value="true" selected>
                                                    Available
                                                </option>
                                                <option value="false">
                                                    Unavailable
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="true">
                                                    Available
                                                </option>
                                                <option value="false" selected>
                                                    Unavailable
                                                </option>
                                            }
                                        </select>
                                    </form>
                                </td>

                                <!-- APPROVAL -->
                                <td>
                                    <form asp-controller="Caregiver"
                                          asp-action="SetApprovalStatus"
                                          method="post"
                                          class="status-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@caregiver.Id" />

                                        <select name="isApproved"
                                                class="form-select status-select @(caregiver.IsApprovedByAdmin ? "select-approved" : "select-pending")"
                                                onchange="this.form.submit()"
                                                aria-label="Change caregiver approval">

                                            @if (caregiver.IsApprovedByAdmin)
                                            {
                                                <option value="true" selected>
                                                    Approved
                                                </option>
                                                <option value="false">
                                                    Pending
                                                </option>
                                            }
                                            else
                                            {
                                                <option value="true">
                                                    Approved
                                                </option>
                                                <option value="false" selected>
                                                    Pending
                                                </option>
                                            }
                                        </select>
                                    </form>
                                </td>

                                <td>
                                    <span class="rating-value">
                                        <i class="bi bi-star-fill"></i>
                                        @caregiver.AverageRating.ToString("0.0")
                                    </span>
                                </td>

                                <!-- ACTIONS -->
                                <td>
                                    <div class="action-buttons">
                                        <a asp-controller="Caregiver"
                                           asp-action="Details"
                                           asp-route-id="@caregiver.Id"
                                           class="action-btn action-view"
                                           title="View caregiver">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-controller="Caregiver"
                                           asp-action="Edit"
                                           asp-route-id="@caregiver.Id"
                                           class="action-btn action-edit"
                                           title="Edit caregiver">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>

                                        <form asp-controller="Caregiver"
                                              asp-action="Delete"
                                              asp-route-id="@caregiver.Id"
                                              method="post"
                                              class="delete-form"
                                              onsubmit="return confirm('Are you sure you want to delete this caregiver?');">

                                            @Html.AntiForgeryToken()

                                            <button type="submit"
                                                    class="action-btn action-delete"
                                                    title="Delete caregiver">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }

                    <tr id="noFilterResults" style="display:none;">
                        <td colspan="8" class="empty-state">
                            <i class="bi bi-search empty-search-icon"></i>
                            <h5>No matching caregivers</h5>
                            <p>Try changing your search or filter selections.</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="table-bottom">
            <i class="bi bi-info-circle me-1"></i>
            Only approved and available caregivers should appear to clients.
        </div>
    </div>
</div>

