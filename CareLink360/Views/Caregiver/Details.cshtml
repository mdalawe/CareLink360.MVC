@model CareLink360.Application.DTOs.CaregiverResponseDto

@{
    ViewData["Title"] = "Caregiver Details";
}

<div class="container py-4">

    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <div>
            <h2 class="fw-bold">
                Caregiver Details
            </h2>

            <p class="text-muted">
                View caregiver information
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-secondary">
            ← Back to Caregivers
        </a>

    </div>


    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <h3 class="fw-bold mb-4">

                @Model.FirstName
                @Model.LastName

            </h3>


            <div class="row g-4">

                <div class="col-md-6">

                    <strong>Phone Number</strong>

                    <p class="text-muted">
                        @Model.PhoneNumber
                    </p>

                </div>


                <div class="col-md-6">

                    <strong>City</strong>

                    <p class="text-muted">
                        @Model.City
                    </p>

                </div>


                <div class="col-md-6">

                    <strong>Experience</strong>

                    <p class="text-muted">
                        @Model.YearsOfExperience years
                    </p>

                </div>


                <div class="col-md-6">

                    <strong>Rating</strong>

                    <p class="text-muted">
                        ⭐ @Model.AverageRating.ToString("0.0") / 5
                    </p>

                </div>


                <div class="col-md-6">

                    <strong>Availability</strong>

                    <p>

                        @if (Model.IsAvaliable)
                        {
                                <span class="badge bg-success">
                                    Available
                                </span>
                        }
                        else
                        {
                                <span class="badge bg-secondary">
                                    Unavailable
                                </span>
                        }

                    </p>

                </div>


                <div class="col-md-6">

                    <strong>NIN Status</strong>

                    <p>

                        @if (Model.IsNinVerified)
                        {
                                <span class="badge bg-success">
                                    Verified
                                </span>
                        }
                        else
                        {
                                <span class="badge bg-warning text-dark">
                                    Not Verified
                                </span>
                        }

                    </p>

                </div>


                <div class="col-md-6">

                    <strong>Admin Approval</strong>

                    <p>

                        @if (Model.IsApprovedByAdmin)
                        {
                                <span class="badge bg-success">
                                    Approved
                                </span>
                        }
                        else
                        {
                                <span class="badge bg-warning text-dark">
                                    Pending
                                </span>
                        }

                    </p>

                </div>

            </div>

        </div>

    </div>


    <div class="mt-4">

        <a asp-action="Index"
           class="btn btn-secondary">
            ← Back
        </a>

    </div>

</div>