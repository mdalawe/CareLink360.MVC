@model CareLink360.Web.Models.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>Login - CareLink360</title>

    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            background: #f4f8fb;
            min-height: 100vh;
            color: #172b4d;
        }

        /* =========================
           TOP HEADER
           ========================= */

        .top-header {
            height: 75px;
            background: white;
            border-bottom: 1px solid #e5eaf0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0 6%;
        }

        .logo {
            font-size: 27px;
            font-weight: 700;
            color: #1264d8;
            text-decoration: none;
        }

        .logo span {
            color: #16a085;
        }

        .back-home {
            text-decoration: none;
            color: #50627a;
            font-size: 14px;
            font-weight: 500;
        }

        .back-home:hover {
            color: #1264d8;
        }


        /* =========================
           MAIN LOGIN AREA
           ========================= */

        .login-wrapper {
            min-height: calc(100vh - 135px);
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 45px 20px;
        }

        .login-container {
            width: 100%;
            max-width: 1050px;
            min-height: 560px;
            background: white;
            border-radius: 18px;
            overflow: hidden;
            box-shadow: 0 15px 45px rgba(26, 55, 85, 0.10);
            display: grid;
            grid-template-columns: 1fr 1fr;
        }


        /* =========================
           LEFT SIDE
           ========================= */

        .login-info {
            background: linear-gradient(
                145deg,
                #1264d8,
                #0b4fae
            );

            color: white;
            padding: 55px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .medical-icon {
            width: 65px;
            height: 65px;
            border-radius: 16px;
            background: rgba(255,255,255,0.16);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 31px;
            margin-bottom: 30px;
        }

        .login-info h1 {
            font-size: 36px;
            line-height: 1.2;
            margin-bottom: 18px;
        }

        .login-info p {
            font-size: 16px;
            line-height: 1.7;
            color: rgba(255,255,255,0.88);
            max-width: 420px;
        }

        .features {
            margin-top: 35px;
        }

        .feature {
            display: flex;
            align-items: center;
            margin-bottom: 17px;
            font-size: 14px;
        }

        .feature-icon {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: rgba(255,255,255,0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-right: 12px;
        }


        /* =========================
           RIGHT LOGIN FORM
           ========================= */

        .login-form {
            padding: 55px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .form-title {
            font-size: 29px;
            font-weight: 700;
            color: #172b4d;
            margin-bottom: 8px;
        }

        .form-subtitle {
            color: #718096;
            font-size: 14px;
            margin-bottom: 32px;
        }

        .form-group {
            margin-bottom: 21px;
        }

        .form-group label {
            display: block;
            font-size: 14px;
            font-weight: 600;
            color: #334155;
            margin-bottom: 8px;
        }

        .input-box {
            width: 100%;
            height: 48px;
            border: 1px solid #d5dde7;
            border-radius: 8px;
            padding: 0 14px;
            font-size: 14px;
            color: #172b4d;
            outline: none;
            background: #fff;
            transition: 0.2s;
        }

        .input-box:focus {
            border-color: #1264d8;
            box-shadow: 0 0 0 3px rgba(18,100,216,0.10);
        }

        .input-box::placeholder {
            color: #a0aec0;
        }


        /* =========================
           REMEMBER / FORGOT
           ========================= */

        .form-options {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            font-size: 13px;
        }

        .remember {
            display: flex;
            align-items: center;
            gap: 7px;
            color: #64748b;
        }

        .remember input {
            width: 15px;
            height: 15px;
        }

        .forgot {
            color: #1264d8;
            text-decoration: none;
            font-weight: 500;
        }

        .forgot:hover {
            text-decoration: underline;
        }


        /* =========================
           BUTTON
           ========================= */

        .login-button {
            width: 100%;
            height: 50px;
            border: none;
            border-radius: 8px;
            background: #1264d8;
            color: white;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
        }

        .login-button:hover {
            background: #0d55b8;
            transform: translateY(-1px);
        }


        /* =========================
           VALIDATION
           ========================= */

        .validation {
            color: #dc3545;
            font-size: 13px;
            margin-top: 5px;
        }

        .summary {
            background: #fff5f5;
            border: 1px solid #fed7d7;
            color: #c53030;
            border-radius: 7px;
            padding: 10px 13px;
            margin-bottom: 20px;
            font-size: 13px;
        }


        /* =========================
           REGISTER
           ========================= */

        .register-text {
            text-align: center;
            margin-top: 25px;
            font-size: 14px;
            color: #718096;
        }

        .register-text a {
            color: #1264d8;
            text-decoration: none;
            font-weight: 600;
        }

        .register-text a:hover {
            text-decoration: underline;
        }


        /* =========================
           FOOTER
           ========================= */

        .footer {
            height: 60px;
            background: white;
            border-top: 1px solid #e5eaf0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #8793a5;
            font-size: 12px;
        }


        /* =========================
           MOBILE
           ========================= */

        @@media (max-width: 800px) {

            .top-header {
                padding: 0 25px;
            }

            .login-container {
                grid-template-columns: 1fr;
                max-width: 520px;
            }

            .login-info {
                display: none;
            }

            .login-form {
                padding: 40px 30px;
            }

            .login-wrapper {
                padding: 25px 15px;
            }
        }
    </style>
</head>

<body>

    <!-- =========================
         HEADER
         ========================= -->

    <header class="top-header">

        <a asp-controller="Home"
           asp-action="Index"
           class="logo">
            CareLink<span>360</span>
        </a>

        <a asp-controller="Home"
           asp-action="Index"
           class="back-home">
            ← Back to website
        </a>

    </header>


    <!-- =========================
         LOGIN
         ========================= -->

    <main class="login-wrapper">

        <div class="login-container">


            <!-- LEFT INFORMATION -->

            <section class="login-info">

                <div class="medical-icon">
                    ♥
                </div>

                <h1>
                    Welcome back
                </h1>

                <p>
                    Sign in to your CareLink360 account
                    and continue managing your healthcare
                    services.
                </p>

                <div class="features">

                    <div class="feature">
                        <div class="feature-icon">
                            ✓
                        </div>

                        <span>
                            Secure account access
                        </span>
                    </div>

                    <div class="feature">
                        <div class="feature-icon">
                            ✓
                        </div>

                        <span>
                            Manage your healthcare profile
                        </span>
                    </div>

                    <div class="feature">
                        <div class="feature-icon">
                            ✓
                        </div>

                        <span>
                            Connect with trusted caregivers
                        </span>
                    </div>

                </div>

            </section>


            <!-- LOGIN FORM -->

            <section class="login-form">

                <h2 class="form-title">
                    Sign in
                </h2>

                <p class="form-subtitle">
                    Enter your details to access your account.
                </p>


                @if (TempData["Error"] != null)
                {
                    <div class="summary">
                        @TempData["Error"]
                    </div>
                }


                <form asp-controller="Auth"
                      asp-action="Login"
                      method="post">

                    @Html.AntiForgeryToken()

                    <div asp-validation-summary="ModelOnly"
                         class="summary">
                    </div>


                    <!-- EMAIL -->

                    <div class="form-group">

                        <label asp-for="Email">
                            Email address
                        </label>

                        <input asp-for="Email"
                               class="input-box"
                               placeholder="Enter your email address"
                               autocomplete="email" />

                        <span asp-validation-for="Email"
                              class="validation">
                        </span>

                    </div>


                    <!-- PASSWORD -->

                    <div class="form-group">

                        <label asp-for="Password">
                            Password
                        </label>

                        <input asp-for="Password"
                               type="password"
                               class="input-box"
                               placeholder="Enter your password"
                               autocomplete="current-password" />

                        <span asp-validation-for="Password"
                              class="validation">
                        </span>

                    </div>


                    <!-- OPTIONS -->

                    <div class="form-options">

                        <label class="remember">

                            <input asp-for="RememberMe" />

                            <span>
                                Remember me
                            </span>

                        </label>

                        <a href="#"
                           class="forgot">
                            Forgot password?
                        </a>

                    </div>


                    <!-- LOGIN BUTTON -->

                    <button type="submit"
                            class="login-button">
                        Sign In
                    </button>

                </form>


                <!-- REGISTER -->

                <div class="register-text">

                    Don't have an account?

                    <a asp-controller="Auth"
                       asp-action="Register">
                        Create an account
                    </a>

                </div>

            </section>

        </div>

    </main>


   

    <footer class="footer">

        © 2026 CareLink360. All Rights Reserved.

    </footer>


</body>
</html>