@model CareLink360.Domain.Entities.Payment
@{
    ViewData["Title"] = "Payment Details";
    Layout = "_AdminLayout";
}

<div class="dashboard-card">
    <h5><i class="fa-solid fa-credit-card me-2"></i>Payment Details</h5>

    <div class="d-flex justify-content-between border-bottom py-2">
        <span class="person-sub">Client</span>
        <span class="person-name">@Model.Client.FirstName @Model.Client.LastName</span>
    </div>

    <div class="d-flex justify-content-between border-bottom py-2">
        <span class="person-sub">Method</span>
        <span class="person-name">@Model.PaymentMethod</span>
    </div>

    <div class="d-flex justify-content-between border-bottom py-2">
        <span class="person-sub">Amount</span>
        <span class="person-name">₦@Model.Amount.ToString("N2")</span>
    </div>

    <div class="d-flex justify-content-between border-bottom py-2">
        <span class="person-sub">Status</span>
        <span class="status-badge status-@Model.Status">@Model.Status</span>
    </div>

    <div class="d-flex justify-content-between py-2">
        <span class="person-sub">Date</span>
        <span class="person-name">@Model.PaymentDate.ToString("MMM dd, yyyy")</span>
    </div>

    <div class="d-flex gap-2 mt-3">
        <a asp-action="UpdateStatus" asp-route-id="@Model.Id" class="btn btn-carelink flex-grow-1">
            Update Status
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>