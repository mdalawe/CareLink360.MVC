@{
    ViewData["Title"] = "Caregiver Dashboard";
    Layout = "_CaregiverLayout";
}

<div class="container-fluid px-4 py-4">

    <div class="mb-4">
        <h1 class="fw-bold">Caregiver Dashboard</h1>

        <p class="text-muted">
            Welcome to your CareLink360 caregiver dashboard.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Job Requests
                    </h6>

                    <h2 class="fw-bold">
                        0
                    </h2>

                    <a asp-controller="JobRequest"
                       asp-action="Index"
                       class="btn btn-sm btn-primary">
                        View Requests
                    </a>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Active Contracts
                    </h6>

                    <h2 class="fw-bold">
                        0
                    </h2>

                    <button class="btn btn-sm btn-outline-primary">
                        View Contracts
                    </button>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Completed Jobs
                    </h6>

                    <h2 class="fw-bold">
                        0
                    </h2>

                    <button class="btn btn-sm btn-outline-primary">
                        View Jobs
                    </button>

                </div>

            </div>

        </div>

        <div class="col-md-6 col-xl-3">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Average Rating
                    </h6>

                    <h2 class="fw-bold">
                        0.0
                    </h2>

                    <button class="btn btn-sm btn-outline-primary">
                        View Ratings
                    </button>

                </div>

            </div>

        </div>

    </div>

    <div class="row mt-4 g-4">

        <div class="col-lg-8">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Quick Actions
                    </h4>

                    <div class="d-flex flex-wrap gap-3">

                        <a asp-controller="JobRequest"
                           asp-action="Index"
                           class="btn btn-primary">
                            View Job Requests
                        </a>

                        <button class="btn btn-outline-primary">
                            My Contracts
                        </button>

                        <button class="btn btn-outline-primary">
                            My Profile
                        </button>

                    </div>

                </div>

            </div>

        </div>

        <div class="col-lg-4">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <h4 class="fw-bold mb-3">
                        Availability
                    </h4>

                    <p class="text-muted">
                        Manage your availability for new
                        caregiving requests.
                    </p>

                    <button class="btn btn-success">
                        Available
                    </button>

                </div>

            </div>

        </div>

    </div>

</div>
