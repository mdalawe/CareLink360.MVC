@model CareLink360.Web.Models.AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h3 class="fw-bold mb-1">Admin Dashboard</h3>
            <p class="text-muted mb-0">
                Welcome back, Admin. Here's what's happening with CareLink360.
            </p>
        </div>

        <div class="text-end">
            <small class="text-muted">Today</small>
            <div class="fw-bold">
                @DateTime.Now.ToString("dd MMM yyyy")
            </div>
        </div>

    </div>


    <!-- ========================= -->
    <!-- STATISTICS -->
    <!-- ========================= -->

    <div class="row g-4 mb-4">

        <!-- Caregivers -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>
                            <p class="text-muted mb-1">
                                Total Caregivers
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.TotalCaregivers
                            </h2>
                        </div>

                        <div class="bg-primary bg-opacity-10 rounded p-3">
                            <i class="bi bi-person-badge fs-3 text-primary"></i>
                        </div>

                    </div>

                    <div class="mt-3">
                        <span class="text-success small">
                            <i class="bi bi-arrow-up"></i>
                            Registered caregivers
                        </span>
                    </div>

                </div>

            </div>

        </div>


        <!-- Clients -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                Total Clients
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.TotalClients
                            </h2>

                        </div>

                        <div class="bg-success bg-opacity-10 rounded p-3">
                            <i class="bi bi-people fs-3 text-success"></i>
                        </div>

                    </div>

                    <div class="mt-3">

                        <span class="text-muted small">
                            Registered clients
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- Job Requests -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                Job Requests
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.TotalJobRequests
                            </h2>

                        </div>

                        <div class="bg-warning bg-opacity-10 rounded p-3">
                            <i class="bi bi-clipboard-check fs-3 text-warning"></i>
                        </div>

                    </div>

                    <div class="mt-3">

                        <span class="text-muted small">
                            Care requests
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- Payments -->
        <div class="col-xl-3 col-md-6">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <p class="text-muted mb-1">
                                Payments
                            </p>

                            <h2 class="fw-bold mb-0">
                                @Model.TotalPayments
                            </h2>

                        </div>

                        <div class="bg-info bg-opacity-10 rounded p-3">
                            <i class="bi bi-credit-card fs-3 text-info"></i>
                        </div>

                    </div>

                    <div class="mt-3">

                        <span class="text-muted small">
                            Recorded payments
                        </span>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- ========================= -->
    <!-- SECONDARY STATISTICS -->
    <!-- ========================= -->

    <div class="row g-4 mb-4">

        <!-- Contracts -->
        <div class="col-xl-4 col-md-6">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="bg-primary bg-opacity-10 rounded p-3 me-3">
                            <i class="bi bi-file-earmark-text fs-3 text-primary"></i>
                        </div>

                        <div>

                            <p class="text-muted mb-1">
                                Active Contracts
                            </p>

                            <h4 class="fw-bold mb-0">
                                @Model.TotalContracts
                            </h4>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Medical Records -->
        <div class="col-xl-4 col-md-6">

            <div class="card border-0 shadow-sm">

                <div class="card-body">

                    <div class="d-flex align-items-center">

                        <div class="bg-success bg-opacity-10 rounded p-3 me-3">
                            <i class="bi bi-heart-pulse fs-3 text-success"></i>
                        </div>

                        <div>

                            <p class="text-muted mb-1">
                                Medical Records
                            </p>

                            <h4 class="fw-bold mb-0">
                                @Model.TotalMedicalRecords
                            </h4>

                        </div>

                    </div>

                </div>

            </div>

        </div>
    <!-- ========================= -->
    <!-- MAIN CONTENT -->
    <!-- ========================= -->

    <div class="row g-4">


        <!-- Quick Actions -->
        <div class="col-xl-8">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="fw-bold mb-1">
                        Quick Actions
                    </h5>

                    <p class="text-muted small mb-0">
                        Frequently used CareLink360 management tools
                    </p>

                </div>


                <div class="card-body">

                    <div class="row g-3">

                        <!-- Add Caregiver -->
                        <div class="col-md-6">

                            <a asp-controller="Caregiver"
                               asp-action="Create"
                               class="text-decoration-none">

                                <div class="border rounded p-3 action-card">

                                    <div class="d-flex align-items-center">

                                        <div class="bg-primary bg-opacity-10 rounded p-3 me-3">

                                            <i class="bi bi-person-plus fs-4 text-primary"></i>

                                        </div>

                                        <div>

                                            <h6 class="fw-bold text-dark mb-1">
                                                Add Caregiver
                                            </h6>

                                            <small class="text-muted">
                                                Register a new caregiver
                                            </small>

                                        </div>

                                    </div>

                                </div>

                            </a>

                        </div>


                        <!-- View Caregivers -->
                        <div class="col-md-6">

                            <a asp-controller="Caregiver"
                               asp-action="Index"
                               class="text-decoration-none">

                                <div class="border rounded p-3 action-card">

                                    <div class="d-flex align-items-center">

                                        <div class="bg-success bg-opacity-10 rounded p-3 me-3">

                                            <i class="bi bi-people fs-4 text-success"></i>

                                        </div>

                                        <div>

                                            <h6 class="fw-bold text-dark mb-1">
                                                View Caregivers
                                            </h6>

                                            <small class="text-muted">
                                                Manage all caregivers
                                            </small>

                                        </div>

                                    </div>

                                </div>

                            </a>

                        </div>


                        <!-- Add Client -->
                        <div class="col-md-6">

                            <a asp-controller="Client"
                               asp-action="Create"
                               class="text-decoration-none">

                                <div class="border rounded p-3 action-card">

                                    <div class="d-flex align-items-center">

                                        <div class="bg-info bg-opacity-10 rounded p-3 me-3">

                                            <i class="bi bi-person-plus fs-4 text-info"></i>

                                        </div>

                                        <div>

                                            <h6 class="fw-bold text-dark mb-1">
                                                Add Client
                                            </h6>

                                            <small class="text-muted">
                                                Register a new client
                                            </small>

                                        </div>

                                    </div>

                                </div>

                            </a>

                        </div>


                        <!-- View Clients -->
                        <div class="col-md-6">

                            <a asp-controller="Client"
                               asp-action="Index"
                               class="text-decoration-none">

                                <div class="border rounded p-3 action-card">

                                    <div class="d-flex align-items-center">

                                        <div class="bg-warning bg-opacity-10 rounded p-3 me-3">

                                            <i class="bi bi-people fs-4 text-warning"></i>

                                        </div>

                                        <div>

                                            <h6 class="fw-bold text-dark mb-1">
                                                View Clients
                                            </h6>

                                            <small class="text-muted">
                                                Manage registered clients
                                            </small>

                                        </div>

                                    </div>

                                </div>

                            </a>

                        </div>


                        <!-- Job Requests -->
                        <div class="col-md-6">

                            <a asp-controller="JobRequest"
                               asp-action="Index"
                               class="text-decoration-none">

                                <div class="border rounded p-3 action-card">

                                    <div class="d-flex align-items-center">

                                        <div class="bg-danger bg-opacity-10 rounded p-3 me-3">

                                            <i class="bi bi-clipboard-check fs-4 text-danger"></i>

                                        </div>

                                        <div>

                                            <h6 class="fw-bold text-dark mb-1">
                                                Job Requests
                                            </h6>

                                            <small class="text-muted">
                                                Manage care requests
                                            </small>

                                        </div>

                                    </div>

                                </div>

                            </a>

                        </div>


                        <!-- NIN Verification -->
                        <div class="col-md-6">

                            <a asp-controller="NinVerification"
                               asp-action="Index"
                               class="text-decoration-none">

                                <div class="border rounded p-3 action-card">

                                    <div class="d-flex align-items-center">

                                        <div class="bg-secondary bg-opacity-10 rounded p-3 me-3">

                                            <i class="bi bi-shield-check fs-4 text-secondary"></i>

                                        </div>

                                        <div>

                                            <h6 class="fw-bold text-dark mb-1">
                                                NIN Verification
                                            </h6>

                                            <small class="text-muted">
                                                Review verification requests
                                            </small>

                                        </div>

                                    </div>

                                </div>

                            </a>

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Platform Overview -->
        <div class="col-xl-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-header bg-white border-0 pt-4 px-4">

                    <h5 class="fw-bold mb-1">
                        Platform Overview
                    </h5>

                    <p class="text-muted small mb-0">
                        Current CareLink360 status
                    </p>

                </div>


                <div class="card-body">

                    <!-- System -->
                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">

                        <div>
                            <span class="fw-semibold">
                                System Status
                            </span>

                            <div class="small text-muted">
                                CareLink360 platform
                            </div>
                        </div>

                        <span class="badge bg-success">
                            Online
                        </span>

                    </div>


                    <!-- Caregivers -->
                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">

                        <div>

                            <span class="fw-semibold">
                                Caregivers
                            </span>

                            <div class="small text-muted">
                                Registered caregivers
                            </div>

                        </div>

                        <strong>
                            @Model.TotalCaregivers
                        </strong>

                    </div>


                    <!-- Clients -->
                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">

                        <div>

                            <span class="fw-semibold">
                                Clients
                            </span>

                            <div class="small text-muted">
                                Registered clients
                            </div>

                        </div>

                        <strong>
                            @Model.TotalClients
                        </strong>

                    </div>


                    <!-- Pending NIN -->
                    <div class="d-flex justify-content-between align-items-center py-3 border-bottom">

                        <div>

                            <span class="fw-semibold">
                                Pending NIN
                            </span>

                            <div class="small text-muted">
                                Verification requests
                            </div>

                        </div>

                        <strong class="text-warning">
                            @Model.PendingNinVerifications
                        </strong>

                    </div>


                    <!-- Rating -->
                    <div class="d-flex justify-content-between align-items-center py-3">

                        <div>

                            <span class="fw-semibold">
                                Average Rating
                            </span>

                            <div class="small text-muted">
                                Caregiver rating
                            </div>

                        </div>

                        <strong class="text-warning">

                            <i class="bi bi-star-fill"></i>

                            @Model.AverageRating.ToString("0.0")

                        </strong>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<style>

    body {
        background-color: #f5f7fb;
    }

    .card {
        border-radius: 10px;
    }

    .action-card {
        transition: all 0.2s ease;
        background: #ffffff;
    }

        .action-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 6px 18px rgba(0,0,0,0.08);
            border-color: #0d6efd !important;
        }

    .card-header {
        border-bottom: 1px solid #f0f0f0 !important;
    }

</style>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            console.log("CareLink360 Admin Dashboard loaded.");

        });

    </script>

}