@model CareLink360.Application.DTOs.CreateContractDto
@{
    ViewData["Title"] = "Create Contract";
}

<div class="edit-client-wrapper">
    <div class="card edit-client-card">
        <div class="edit-client-header">
            <h3><i class="bi bi-file-earmark-plus me-2"></i>Create Contract</h3>
            <p>Link a client, caregiver, and job request together</p>
        </div>
        <div class="edit-client-body">

            @if (!ViewData.ModelState.IsValid)
            {
                    <div class="alert alert-danger">
                        <ul class="mb-0">
                        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                        {
                                    <li>@error.ErrorMessage</li>
                        }
                        </ul>
                    </div>
            }

            <form asp-action="Create" method="post">

                <div class="form-floating mb-3">
                    <input asp-for="ClientId" class="form-control" placeholder="Client Id" />
                    <label asp-for="ClientId"><i class="bi bi-person me-1"></i>Client Id</label>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="CaregiverId" class="form-control" placeholder="Caregiver Id" />
                    <label asp-for="CaregiverId"><i class="bi bi-person-badge me-1"></i>Caregiver Id</label>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="JobRequestId" class="form-control" placeholder="Job Request Id" />
                    <label asp-for="JobRequestId"><i class="bi bi-briefcase me-1"></i>Job Request Id</label>
                </div>

                <div class="form-actions">
                    <button class="btn btn-gradient flex-grow-1">
                        <i class="bi bi-check2-circle me-1"></i> Create Contract
                    </button>
                    <a asp-action="Index" class="btn btn-outline-cancel">
                        <i class="bi bi-x-circle me-1"></i> Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>