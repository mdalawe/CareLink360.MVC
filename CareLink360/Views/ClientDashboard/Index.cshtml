@{
    ViewData["Title"] = "Client Dashboard";
    Layout = "_ClientLayout";
}

<style>
    .client-dashboard {
        min-height: 100vh;
        background: #f4f8f9;
        padding: 30px;
    }

    .client-wrapper {
        max-width: 1450px;
        margin: 0 auto;
    }

    .client-welcome {
        background: linear-gradient(135deg, #0f766e 0%, #0d9488 55%, #14b8a6 100%);
        border-radius: 24px;
        padding: 38px 42px;
        color: white;
        position: relative;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(15, 118, 110, 0.18);
        margin-bottom: 28px;
    }

    .client-welcome::after {
        content: "";
        position: absolute;
        width: 240px;
        height: 240px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.08);
        right: -70px;
        top: -90px;
    }

    .client-welcome::before {
        content: "";
        position: absolute;
        width: 150px;
        height: 150px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.06);
        right: 130px;
        bottom: -100px;
    }

    .welcome-content {
        position: relative;
        z-index: 2;
        max-width: 720px;
    }

    .welcome-label {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        font-weight: 600;
        background: rgba(255, 255, 255, 0.14);
        padding: 8px 13px;
        border-radius: 30px;
        margin-bottom: 18px;
    }

    .client-welcome h1 {
        font-size: 34px;
        font-weight: 750;
        margin: 0 0 12px;
        letter-spacing: -0.5px;
    }

    .client-welcome p {
        margin: 0;
        font-size: 16px;
        line-height: 1.7;
        opacity: 0.94;
        max-width: 650px;
    }

    .request-button {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-top: 25px;
        background: white;
        color: #0f766e;
        padding: 13px 21px;
        border-radius: 11px;
        text-decoration: none;
        font-weight: 700;
        transition: 0.2s ease;
    }

    .request-button:hover {
        color: #0f766e;
        transform: translateY(-2px);
        box-shadow: 0 8px 18px rgba(0, 0, 0, 0.12);
    }

    .dashboard-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 15px;
    }

    .dashboard-heading h2 {
        font-size: 21px;
        font-weight: 700;
        color: #172b2f;
        margin: 0;
    }

    .dashboard-heading span {
        color: #7a8b8f;
        font-size: 13px;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 32px;
    }

    .client-stat {
        background: white;
        border: 1px solid #e7eeee;
        border-radius: 17px;
        padding: 22px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 5px 18px rgba(23, 43, 47, 0.05);
        transition: 0.2s ease;
    }

    .client-stat:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 25px rgba(23, 43, 47, 0.08);
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }

    .stat-icon.requests {
        background: #e8f7f5;
        color: #0f766e;
    }

    .stat-icon.contracts {
        background: #edf3ff;
        color: #315da8;
    }

    .stat-icon.payments {
        background: #fff5e6;
        color: #b66a00;
    }

    .stat-icon.ratings {
        background: #fff7dc;
        color: #a56b00;
    }

    .stat-number {
        font-size: 25px;
        font-weight: 750;
        color: #172b2f;
        line-height: 1;
        margin-bottom: 6px;
    }

    .stat-label {
        font-size: 13px;
        color: #7a8b8f;
    }

    .quick-section {
        margin-top: 5px;
    }

    .quick-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
    }

    .quick-card {
        background: white;
        border: 1px solid #e7eeee;
        border-radius: 17px;
        padding: 23px;
        text-decoration: none;
        display: block;
        box-shadow: 0 5px 18px rgba(23, 43, 47, 0.05);
        transition: 0.2s ease;
    }

    .quick-card:hover {
        transform: translateY(-4px);
        border-color: #b9ded9;
        box-shadow: 0 12px 28px rgba(23, 43, 47, 0.09);
    }

    .quick-icon {
        width: 48px;
        height: 48px;
        border-radius: 13px;
        background: #edf8f7;
        color: #0f766e;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        margin-bottom: 17px;
    }

    .quick-card h3 {
        color: #172b2f;
        font-size: 16px;
        font-weight: 700;
        margin: 0 0 7px;
    }

    .quick-card p {
        color: #7a8b8f;
        font-size: 13px;
        line-height: 1.5;
        margin: 0;
    }

    .quick-arrow {
        display: flex;
        justify-content: flex-end;
        color: #0f766e;
        margin-top: 15px;
        font-size: 14px;
    }

    .care-info {
        margin-top: 28px;
        background: white;
        border: 1px solid #e7eeee;
        border-radius: 18px;
        padding: 22px 25px;
        display: flex;
        align-items: center;
        gap: 17px;
        box-shadow: 0 5px 18px rgba(23, 43, 47, 0.04);
    }

    .care-info-icon {
        width: 48px;
        height: 48px;
        min-width: 48px;
        border-radius: 13px;
        background: #e8f7f5;
        color: #0f766e;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .care-info h3 {
        margin: 0 0 5px;
        color: #172b2f;
        font-size: 15px;
        font-weight: 700;
    }

    .care-info p {
        margin: 0;
        color: #7a8b8f;
        font-size: 13px;
    }

    @@media (max-width: 1100px) {
        .stats-grid,
        .quick-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 700px) {
        .client-dashboard {
            padding: 18px;
        }

        .client-welcome {
            padding: 28px 24px;
            border-radius: 19px;
        }

        .client-welcome h1 {
            font-size: 27px;
        }

        .stats-grid,
        .quick-grid {
            grid-template-columns: 1fr;
        }

        .care-info {
            align-items: flex-start;
        }
    }
</style>

<div class="client-dashboard">

    <div class="client-wrapper">

        <div class="client-welcome">

            <div class="welcome-content">

                <div class="welcome-label">
                    <i class="fa-solid fa-heart-pulse"></i>
                    CareLink360 Client Portal
                </div>

                <h1>
                    Welcome to CareLink360
                </h1>

                <p>
                    Find trusted caregivers, manage your care requests,
                    review your contracts, and stay connected with your
                    care journey from one place.
                </p>

                <a asp-controller="Caregiver"
                   asp-action="Browse"
                   class="request-button">

                    <i class="fa-solid fa-user-nurse"></i>
                    Find a Caregiver

                </a>

            </div>

        </div>

        <div class="dashboard-heading">

            <h2>
                Your Overview
            </h2>

            <span>
                Care at a glance
            </span>

        </div>

        <div class="stats-grid">

            <div class="client-stat">

                <div class="stat-icon requests">
                    <i class="fa-solid fa-clipboard-list"></i>
                </div>

                <div>
                    <div class="stat-number">0</div>
                    <div class="stat-label">Care Requests</div>
                </div>

            </div>

            <div class="client-stat">

                <div class="stat-icon contracts">
                    <i class="fa-solid fa-file-contract"></i>
                </div>

                <div>
                    <div class="stat-number">0</div>
                    <div class="stat-label">Active Contracts</div>
                </div>

            </div>

            <div class="client-stat">

                <div class="stat-icon payments">
                    <i class="fa-solid fa-credit-card"></i>
                </div>

                <div>
                    <div class="stat-number">0</div>
                    <div class="stat-label">Payments</div>
                </div>

            </div>

            <div class="client-stat">

                <div class="stat-icon ratings">
                    <i class="fa-solid fa-star"></i>
                </div>

                <div>
                    <div class="stat-number">0</div>
                    <div class="stat-label">Ratings Given</div>
                </div>

            </div>

        </div>

        <div class="quick-section">

            <div class="dashboard-heading">

                <h2>
                    Quick Actions
                </h2>

                <span>
                    Manage your care
                </span>

            </div>

            <div class="quick-grid">

                <a asp-controller="Caregiver"
                   asp-action="Browse"
                   class="quick-card">

                    <div class="quick-icon">
                        <i class="fa-solid fa-user-nurse"></i>
                    </div>

                    <h3>
                        Find a Caregiver
                    </h3>

                    <p>
                        Browse available caregivers and choose the right person for your care needs.
                    </p>

                    <div class="quick-arrow">
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>

                </a>

                <a asp-controller="JobRequest"
                   asp-action="MyCreatedRequests"
                   class="quick-card">

                    <div class="quick-icon">
                        <i class="fa-solid fa-clipboard-list"></i>
                    </div>

                    <h3>
                        My Requests
                    </h3>

                    <p>
                        Check the status of your submitted caregiver requests.
                    </p>

                    <div class="quick-arrow">
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>

                </a>

                <a asp-controller="Contract"
                   asp-action="MyContracts"
                   class="quick-card">

                    <div class="quick-icon">
                        <i class="fa-solid fa-file-signature"></i>
                    </div>

                    <h3>
                        My Contracts
                    </h3>

                    <p>
                        View and manage your current caregiver contracts.
                    </p>

                    <div class="quick-arrow">
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>

                </a>

                <a asp-controller="ClientProfile"
                   asp-action="Index"
                   class="quick-card">

                    <div class="quick-icon">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <h3>
                        My Profile
                    </h3>

                    <p>
                        View your personal information and client profile.
                    </p>

                    <div class="quick-arrow">
                        <i class="fa-solid fa-arrow-right"></i>
                    </div>

                </a>

            </div>

        </div>

        <div class="care-info">

            <div class="care-info-icon">
                <i class="fa-solid fa-shield-heart"></i>
            </div>

            <div>

                <h3>
                    Your care, your choice
                </h3>

                <p>
                    Browse available caregivers and choose the professional
                    that best matches your care requirements.
                </p>

            </div>

        </div>

    </div>

</div>