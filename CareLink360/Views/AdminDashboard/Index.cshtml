@model CareLink360.Web.Models.AdminDashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
}

<style>

    :root {
        --care-primary: #0f766e;
        --care-primary-dark: #115e59;
        --care-blue: #2563eb;
        --care-green: #16a34a;
        --care-orange: #ea580c;
        --care-purple: #7c3aed;

        --care-bg: #f3f7f9;
        --care-card: #ffffff;
        --care-text: #172033;
        --care-muted: #64748b;
        --care-border: #e2e8f0;

        --care-shadow:
            0 10px 30px rgba(15, 23, 42, 0.07);
    }


    /* ================================
       PAGE
    ================================= */

    .admin-page {

        min-height: 100vh;

        padding: 35px 45px 70px;

        background:
            linear-gradient(
                135deg,
                rgba(243, 250, 250, .96),
                rgba(238, 246, 251, .96)
            );

        font-family:
            "Segoe UI",
            Arial,
            sans-serif;

        color: var(--care-text);
    }


    /* ================================
       TOP HEADER
    ================================= */

    .dashboard-header {

        display: flex;

        justify-content: space-between;

        align-items: center;

        gap: 25px;

        margin-bottom: 32px;
    }


    .welcome-area h1 {

        margin: 0;

        font-size: 38px;

        font-weight: 800;

        letter-spacing: -.7px;

        color: #12395b;
    }


    .welcome-area p {

        margin: 8px 0 0;

        color: var(--care-muted);

        font-size: 17px;
    }


    .header-right {

        display: flex;

        align-items: center;

        gap: 12px;
    }


    .today-box {

        background: white;

        border: 1px solid var(--care-border);

        border-radius: 15px;

        padding: 13px 20px;

        min-width: 170px;

        box-shadow: var(--care-shadow);
    }


    .today-box span {

        display: block;

        font-size: 12px;

        color: var(--care-muted);

        margin-bottom: 4px;
    }


    .today-box strong {

        font-size: 16px;

        color: #17324d;
    }


    /* ================================
       QUICK WELCOME
    ================================= */

    .welcome-banner {

        position: relative;

        overflow: hidden;

        border-radius: 22px;

        padding: 30px 35px;

        margin-bottom: 30px;

        background:
            linear-gradient(
                120deg,
                #0f766e,
                #087f8c,
                #2563eb
            );

        color: white;

        box-shadow:
            0 15px 35px rgba(15,118,110,.20);
    }


    .welcome-banner::after {

        content: "♥";

        position: absolute;

        right: 45px;

        top: 5px;

        font-size: 150px;

        opacity: .08;
    }


    .welcome-banner h2 {

        position: relative;

        z-index: 2;

        margin: 0 0 8px;

        font-size: 27px;

        font-weight: 800;
    }


    .welcome-banner p {

        position: relative;

        z-index: 2;

        margin: 0;

        max-width: 700px;

        font-size: 16px;

        opacity: .92;
    }


    /* ================================
       STATISTICS
    ================================= */

    .stats-grid {

        display: grid;

        grid-template-columns:
            repeat(4, 1fr);

        gap: 20px;

        margin-bottom: 25px;
    }


    .stat-card {

        position: relative;

        overflow: hidden;

        background: white;

        border: 1px solid var(--care-border);

        border-radius: 18px;

        padding: 23px;

        min-height: 175px;

        box-shadow: var(--care-shadow);

        transition:
            transform .25s ease,
            box-shadow .25s ease;
    }


    .stat-card:hover {

        transform: translateY(-5px);

        box-shadow:
            0 17px 38px rgba(15,23,42,.12);
    }


    .stat-card::before {

        content: "";

        position: absolute;

        top: 0;

        left: 0;

        width: 100%;

        height: 4px;

        background: var(--care-primary);
    }


    .stat-card.blue::before {
        background: var(--care-blue);
    }

    .stat-card.green::before {
        background: var(--care-green);
    }

    .stat-card.orange::before {
        background: var(--care-orange);
    }

    .stat-card.purple::before {
        background: var(--care-purple);
    }


    .stat-top {

        display: flex;

        justify-content: space-between;

        align-items: center;
    }


    .stat-label {

        font-size: 15px;

        font-weight: 700;

        color: var(--care-muted);
    }


    .stat-icon {

        width: 50px;

        height: 50px;

        border-radius: 14px;

        display: flex;

        align-items: center;

        justify-content: center;

        font-size: 23px;
    }


    .icon-blue {
        background: #dbeafe;
    }

    .icon-green {
        background: #dcfce7;
    }

    .icon-orange {
        background: #ffedd5;
    }

    .icon-purple {
        background: #ede9fe;
    }


    .stat-number {

        margin-top: 20px;

        font-size: 35px;

        line-height: 1;

        font-weight: 850;

        color: #14263a;
    }


    .stat-description {

        margin-top: 9px;

        color: var(--care-muted);

        font-size: 14px;
    }


    .stat-link {

        display: inline-block;

        margin-top: 17px;

        color: var(--care-primary);

        font-size: 14px;

        font-weight: 750;

        text-decoration: none;
    }


    .stat-link:hover {

        color: var(--care-primary-dark);

        transform: translateX(3px);
    }


    /* ================================
       SECONDARY STATS
    ================================= */

    .secondary-grid {

        display: grid;

        grid-template-columns:
            repeat(3, 1fr);

        gap: 20px;

        margin-bottom: 28px;
    }


    .secondary-card {

        background: white;

        border: 1px solid var(--care-border);

        border-radius: 17px;

        padding: 22px 25px;

        box-shadow: var(--care-shadow);

        transition: .25s ease;
    }


    .secondary-card:hover {

        transform: translateY(-3px);

        box-shadow:
            0 13px 30px rgba(15,23,42,.10);
    }


    .secondary-title {

        color: var(--care-muted);

        font-weight: 700;

        font-size: 14px;
    }


    .secondary-number {

        font-size: 30px;

        font-weight: 800;

        margin-top: 10px;

        color: #17324d;
    }


    .secondary-text {

        color: var(--care-muted);

        font-size: 13px;

        margin-top: 4px;
    }


    /* ================================
       CONTENT
    ================================= */

    .main-grid {

        display: grid;

        grid-template-columns:
            1.5fr 1fr;

        gap: 22px;
    }


    .panel {

        background: white;

        border: 1px solid var(--care-border);

        border-radius: 19px;

        overflow: hidden;

        box-shadow: var(--care-shadow);
    }


    .panel-header {

        padding: 23px 25px;

        border-bottom: 1px solid var(--care-border);

        background: #fbfdfe;
    }


    .panel-header h3 {

        margin: 0;

        font-size: 20px;

        font-weight: 800;
    }


    .panel-header p {

        margin: 5px 0 0;

        color: var(--care-muted);

        font-size: 14px;
    }


    .panel-body {

        padding: 22px 25px;
    }


    /* ================================
       QUICK ACTIONS
    ================================= */

    .actions-grid {

        display: grid;

        grid-template-columns:
            repeat(2, 1fr);

        gap: 13px;
    }


    .action {

        display: flex;

        align-items: center;

        gap: 14px;

        padding: 16px;

        border: 1px solid var(--care-border);

        border-radius: 14px;

        text-decoration: none;

        color: var(--care-text);

        transition: .25s ease;

        background: white;
    }


    .action:hover {

        transform: translateY(-3px);

        border-color: var(--care-primary);

        background: #f0fdfa;

        color: var(--care-text);

        box-shadow:
            0 7px 20px rgba(15,118,110,.10);
    }


    .action-icon {

        width: 46px;

        height: 46px;

        min-width: 46px;

        border-radius: 13px;

        display: flex;

        align-items: center;

        justify-content: center;

        background: #ccfbf1;

        font-size: 21px;
    }


    .action strong {

        display: block;

        font-size: 15px;

        margin-bottom: 3px;
    }


    .action span {

        display: block;

        font-size: 13px;

        color: var(--care-muted);
    }


    /* ================================
       SYSTEM OVERVIEW
    ================================= */

    .system-row {

        display: flex;

        justify-content: space-between;

        align-items: center;

        padding: 16px 0;

        border-bottom: 1px solid #edf2f7;
    }


    .system-row:last-child {

        border-bottom: none;
    }


    .system-name {

        color: var(--care-muted);

        font-size: 14px;
    }


    .system-value {

        font-size: 15px;

        font-weight: 800;

        color: #17324d;
    }


    .online {

        display: inline-flex;

        align-items: center;

        gap: 7px;

        padding: 7px 12px;

        border-radius: 25px;

        background: #dcfce7;

        color: #15803d;

        font-size: 13px;

        font-weight: 800;
    }


    .online-dot {

        width: 8px;

        height: 8px;

        border-radius: 50%;

        background: #16a34a;
    }


    /* ================================
       MANAGEMENT
    ================================= */

    .management {

        margin-top: 24px;

        background: white;

        border: 1px solid var(--care-border);

        border-radius: 19px;

        padding: 25px;

        box-shadow: var(--care-shadow);
    }


    .management h3 {

        margin: 0;

        font-size: 20px;

        font-weight: 800;
    }


    .management p {

        margin: 5px 0 22px;

        color: var(--care-muted);

        font-size: 14px;
    }


    .management-grid {

        display: grid;

        grid-template-columns:
            repeat(3, 1fr);

        gap: 15px;
    }


    .management-item {

        display: flex;

        align-items: center;

        gap: 13px;

        padding: 17px;

        border: 1px solid var(--care-border);

        border-radius: 14px;

        text-decoration: none;

        color: var(--care-text);

        transition: .25s ease;
    }


    .management-item:hover {

        border-color: var(--care-primary);

        background: #f0fdfa;

        transform: translateY(-3px);

        color: var(--care-text);
    }


    .management-icon {

        width: 46px;

        height: 46px;

        min-width: 46px;

        display: flex;

        align-items: center;

        justify-content: center;

        border-radius: 12px;

        background: #ccfbf1;

        font-size: 21px;
    }


    .management-item strong {

        display: block;

        font-size: 15px;
    }


    .management-item span {

        color: var(--care-muted);

        font-size: 13px;
    }


    /* ================================
       RESPONSIVE
    ================================= */

    @@media (max-width: 1200px) {

        .stats-grid {

            grid-template-columns:
                repeat(2, 1fr);
        }

        .main-grid {

            grid-template-columns: 1fr;
        }

    }


    @@media (max-width: 900px) {

        .admin-page {

            padding: 25px 20px 50px;
        }

        .dashboard-header {

            align-items: flex-start;

            flex-direction: column;
        }

        .secondary-grid {

            grid-template-columns: 1fr;
        }

        .management-grid {

            grid-template-columns: 1fr;
        }

    }


    @@media (max-width: 600px) {

        .admin-page {

            padding: 20px 14px 40px;
        }

        .welcome-area h1 {

            font-size: 29px;
        }

        .welcome-area p {

            font-size: 15px;
        }

        .stats-grid {

            grid-template-columns: 1fr;
        }

        .actions-grid {

            grid-template-columns: 1fr;
        }

        .welcome-banner {

            padding: 25px;
        }

        .welcome-banner h2 {

            font-size: 23px;
        }

    }

</style>


<div class="admin-page">


    <!-- =================================
         HEADER
    ================================== -->

    <div class="dashboard-header">

        <div class="welcome-area">

            <h1>
                Admin Dashboard
            </h1>

            <p>
                Manage your CareLink360 healthcare platform.
            </p>

        </div>


        <div class="header-right">

            <div class="today-box">

                <span>
                    Today
                </span>

                <strong>
                    @DateTime.Now.ToString("dd MMM yyyy")
                </strong>

            </div>

        </div>

    </div>


    <!-- =================================
         WELCOME BANNER
    ================================== -->

    <div class="welcome-banner">

        <h2>
            Welcome back, Admin 👋
        </h2>

        <p>
            Monitor caregivers, clients, care requests,
            payments and verification activities from one place.
        </p>

    </div>


    <!-- =================================
         MAIN STATISTICS
    ================================== -->

    <div class="stats-grid">


        <!-- CAREGIVERS -->

        <div class="stat-card blue">

            <div class="stat-top">

                <div class="stat-label">
                    Caregivers
                </div>

                <div class="stat-icon icon-blue">
                    👨‍⚕️
                </div>

            </div>


            <div class="stat-number">
                @Model.TotalCaregivers
            </div>

            <div class="stat-description">
                Registered caregivers
            </div>


            <a asp-controller="Caregiver"
               asp-action="Index"
               class="stat-link">

                Manage caregivers →

            </a>

        </div>


        <!-- CLIENTS -->

        <div class="stat-card green">

            <div class="stat-top">

                <div class="stat-label">
                    Clients
                </div>

                <div class="stat-icon icon-green">
                    👥
                </div>

            </div>


            <div class="stat-number">
                @Model.TotalClients
            </div>

            <div class="stat-description">
                Registered clients
            </div>


            <a asp-controller="Client"
               asp-action="Index"
               class="stat-link">

                Manage clients →

            </a>

        </div>


        <!-- JOB REQUESTS -->

        <div class="stat-card orange">

            <div class="stat-top">

                <div class="stat-label">
                    Job Requests
                </div>

                <div class="stat-icon icon-orange">
                    📋
                </div>

            </div>


            <div class="stat-number">
                @Model.TotalJobRequests
            </div>

            <div class="stat-description">
                Active care requests
            </div>


            <a asp-controller="JobRequest"
               asp-action="Index"
               class="stat-link">

                View requests →

            </a>

        </div>


        <!-- PAYMENTS -->

        <div class="stat-card purple">

            <div class="stat-top">

                <div class="stat-label">
                    Payments
                </div>

                <div class="stat-icon icon-purple">
                    💳
                </div>

            </div>


            <div class="stat-number">
                @Model.TotalPayments
            </div>

            <div class="stat-description">
                Recorded payments
            </div>


            <a asp-controller="Payment"
               asp-action="Index"
               class="stat-link">

                View payments →

            </a>

        </div>

    </div>


    <!-- =================================
         SECONDARY STATISTICS
    ================================== -->

    <div class="secondary-grid">


        <div class="secondary-card">

            <div class="secondary-title">
                Active Contracts
            </div>

            <div class="secondary-number">
                @Model.TotalContracts
            </div>

            <div class="secondary-text">
                Current care contracts
            </div>

        </div>


        <div class="secondary-card">

            <div class="secondary-title">
                Medical Records
            </div>

            <div class="secondary-number">
                @Model.TotalMedicalRecords
            </div>

            <div class="secondary-text">
                Records stored securely
            </div>

        </div>


        <div class="secondary-card">

            <div class="secondary-title">
                Pending NIN Verification
            </div>

            <div class="secondary-number">
                @Model.PendingNinVerifications
            </div>

            <div class="secondary-text">
                Verification requests
            </div>

        </div>

    </div>


    <!-- =================================
         MAIN CONTENT
    ================================== -->

    <div class="main-grid">


        <!-- QUICK ACTIONS -->

        <div class="panel">

            <div class="panel-header">

                <h3>
                    Quick Actions
                </h3>

                <p>
                    Frequently used CareLink360 management tools.
                </p>

            </div>


            <div class="panel-body">

                <div class="actions-grid">


                    <a asp-controller="Caregiver"
                       asp-action="Create"
                       class="action">

                        <div class="action-icon">
                            👨‍⚕️
                        </div>

                        <div>

                            <strong>
                                Add Caregiver
                            </strong>

                            <span>
                                Register a new caregiver
                            </span>

                        </div>

                    </a>


                    <a asp-controller="Caregiver"
                       asp-action="Index"
                       class="action">

                        <div class="action-icon">
                            👥
                        </div>

                        <div>

                            <strong>
                                Manage Caregivers
                            </strong>

                            <span>
                                View registered caregivers
                            </span>

                        </div>

                    </a>


                    <a asp-controller="Client"
                       asp-action="Create"
                       class="action">

                        <div class="action-icon">
                            👤
                        </div>

                        <div>

                            <strong>
                                Add Client
                            </strong>

                            <span>
                                Register a new client
                            </span>

                        </div>

                    </a>


                    <a asp-controller="Client"
                       asp-action="Index"
                       class="action">

                        <div class="action-icon">
                            👥
                        </div>

                        <div>

                            <strong>
                                Manage Clients
                            </strong>

                            <span>
                                View registered clients
                            </span>

                        </div>

                    </a>


                    <a asp-controller="JobRequest"
                       asp-action="Create"
                       class="action">

                        <div class="action-icon">
                            📋
                        </div>

                        <div>

                            <strong>
                                Create Job Request
                            </strong>

                            <span>
                                Create a new care request
                            </span>

                        </div>

                    </a>


                    <a asp-controller="NinVerification"
                       asp-action="Index"
                       class="action">

                        <div class="action-icon">
                            🪪
                        </div>

                        <div>

                            <strong>
                                NIN Verification
                            </strong>

                            <span>
                                Review verification requests
                            </span>

                        </div>

                    </a>

                </div>

            </div>

        </div>


        <!-- SYSTEM OVERVIEW -->

        <div class="panel">

            <div class="panel-header">

                <h3>
                    System Overview
                </h3>

                <p>
                    Current platform activity.
                </p>

            </div>


            <div class="panel-body">


                <div class="system-row">

                    <span class="system-name">
                        System Status
                    </span>

                    <span class="online">

                        <span class="online-dot"></span>

                        Online

                    </span>

                </div>


                <div class="system-row">

                    <span class="system-name">
                        Caregivers Registered
                    </span>

                    <span class="system-value">
                        @Model.TotalCaregivers
                    </span>

                </div>


                <div class="system-row">

                    <span class="system-name">
                        Clients Registered
                    </span>

                    <span class="system-value">
                        @Model.TotalClients
                    </span>

                </div>


                <div class="system-row">

                    <span class="system-name">
                        Job Requests
                    </span>

                    <span class="system-value">
                        @Model.TotalJobRequests
                    </span>

                </div>


                <div class="system-row">

                    <span class="system-name">
                        Pending NIN
                    </span>

                    <span class="system-value">
                        @Model.PendingNinVerifications
                    </span>

                </div>


            </div>

        </div>

    </div>


    <!-- =================================
         MANAGEMENT
    ================================== -->

    <div class="management">

        <h3>
            CareLink360 Management
        </h3>

        <p>
            Access and manage the main areas of your healthcare platform.
        </p>


        <div class="management-grid">


            <a asp-controller="Caregiver"
               asp-action="Index"
               class="management-item">

                <div class="management-icon">
                    👨‍⚕️
                </div>

                <div>

                    <strong>
                        All Caregivers
                    </strong>

                    <span>
                        @Model.TotalCaregivers registered
                    </span>

                </div>

            </a>


            <a asp-controller="Client"
               asp-action="Index"
               class="management-item">

                <div class="management-icon">
                    👥
                </div>

                <div>

                    <strong>
                        All Clients
                    </strong>

                    <span>
                        @Model.TotalClients registered
                    </span>

                </div>

            </a>


            <a asp-controller="JobRequest"
               asp-action="Index"
               class="management-item">

                <div class="management-icon">
                    📋
                </div>

                <div>

                    <strong>
                        Job Requests
                    </strong>

                    <span>
                        @Model.TotalJobRequests requests
                    </span>

                </div>

            </a>


        </div>

    </div>

</div>