                                Manage and monitor all registered caregivers.
                            </p>

                        </div>

                    </div>


                    <div class="page-actions">

                        <a asp-controller="AdminDashboard"
                           asp-action="Index"
                           class="btn-dashboard">

                            <i class="bi bi-arrow-left"></i>

                            Dashboard

                        </a>


                        <a asp-action="Create"
                           class="btn-add-caregiver">

                            <i class="bi bi-plus-lg"></i>

                            Add Caregiver

                        </a>

                    </div>

                </div>


                <!-- =================================================
                     ALERTS
                ================================================== -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show cl-alert mb-4">

                        <i class="bi bi-check-circle-fill me-2"></i>

                        @TempData["Success"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>

                    </div>
                }


                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show cl-alert mb-4">

                        <i class="bi bi-exclamation-circle-fill me-2"></i>

                        @TempData["Error"]

                        <button type="button"
                                class="btn-close"
                                data-bs-dismiss="alert">
                        </button>

                    </div>
                }


                <!-- =================================================
                     STATISTICS
                ================================================== -->

                <div class="stats-grid">


                    <!-- TOTAL -->

                    <div class="stat-card">

                        <div class="stat-top">

                            <span class="stat-label">
                                Total Caregivers
                            </span>

                            <div class="stat-icon icon-teal">

                                <i class="bi bi-people-fill"></i>

                            </div>

                        </div>

                        <div class="stat-number">
                            @totalCaregivers
                        </div>

                        <div class="stat-description">
                            All registered caregivers
                        </div>

                    </div>


                    <!-- AVAILABLE -->

                    <div class="stat-card">

                        <div class="stat-top">

                            <span class="stat-label">
                                Available
                            </span>

                            <div class="stat-icon icon-green">

                                <i class="bi bi-check-circle-fill"></i>

                            </div>

                        </div>

                        <div class="stat-number">
                            @availableCaregivers
                        </div>

                        <div class="stat-description">
                            Available for care jobs
                        </div>

                    </div>


                    <!-- PENDING -->

                    <div class="stat-card">

                        <div class="stat-top">

                            <span class="stat-label">
                                Pending Verification
                            </span>

                            <div class="stat-icon icon-orange">

                                <i class="bi bi-hourglass-split"></i>

                            </div>

                        </div>

                        <div class="stat-number">
                            @pendingCaregivers
                        </div>

                        <div class="stat-description">
                            Awaiting NIN verification
                        </div>

                    </div>


                    <!-- VERIFIED -->

                    <div class="stat-card">

                        <div class="stat-top">

                            <span class="stat-label">
                                NIN Verified
                            </span>

                            <div class="stat-icon icon-purple">

                                <i class="bi bi-patch-check-fill"></i>

                            </div>

                        </div>

                        <div class="stat-number">
                            @verifiedCaregivers
                        </div>

                        <div class="stat-description">
                            Verified caregiver profiles
                        </div>

                    </div>

                </div>


                <!-- =================================================
                     FILTERS
                ================================================== -->

                <div class="filter-card">

                    <div class="filter-row">


                        <!-- SEARCH -->

                        <div class="filter-group">

                            <label>
                                Search
                            </label>

                            <div class="search-wrapper">

                                <i class="bi bi-search"></i>

                                <input type="text"
                                       id="caregiverSearch"
                                       class="filter-input"
                                       placeholder="Search by name, phone or city..." />

                            </div>

                        </div>


                        <!-- AVAILABILITY -->

                        <div class="filter-group">

                            <label>
                                Availability
                            </label>

                            <select id="availabilityFilter"
                                    class="filter-select">

                                <option value="all">
                                    All Status
                                </option>

                                <option value="available">
                                    Available
                                </option>

                                <option value="unavailable">
                                    Unavailable
                                </option>

                            </select>

                        </div>


                        <!-- NIN -->

                        <div class="filter-group">

                            <label>
                                NIN Verification
                            </label>

                            <select id="ninFilter"
                                    class="filter-select">

                                <option value="all">
                                    All
                                </option>

                                <option value="verified">
                                    Verified
                                </option>

                                <option value="pending">
                                    Pending
                                </option>

                            </select>

                        </div>


                        <!-- CITY -->

                        <div class="filter-group">

                            <label>
                                City
                            </label>

                            <select id="cityFilter"
                                    class="filter-select">

                                <option value="all">
                                    All Cities
                                </option>

                            </select>

                        </div>


                        <!-- FILTER BUTTON -->

                        <div>

                            <button type="button"
                                    class="filter-btn"
                                    onclick="resetCaregiverFilters()">

                                <i class="bi bi-arrow-clockwise"></i>

                                Reset

                            </button>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     TABLE
                ================================================== -->

                <div class="table-card">


                    <!-- TABLE HEADER -->

                    <div class="table-header">

                        <div class="table-title">

                            <div class="table-title-icon">

                                <i class="bi bi-people-fill"></i>

                            </div>

                            <div>

                                <h5>
                                    Registered Caregivers
                                </h5>

                                <p>
                                    View and manage caregiver profiles
                                </p>

                            </div>

                        </div>


                        <button type="button"
                                class="export-btn">

                            <i class="bi bi-download"></i>

                            Export

                        </button>

                    </div>


                    <!-- TABLE -->
                    @if (!caregivers.Any())
                    {
                        <div class="empty-state">

                            <div class="empty-icon">

                                <i class="bi bi-person-x"></i>

                            </div>

                            <h5>
                                No caregivers found
                            </h5>

                            <p>
                                You haven't registered any caregivers yet.
                            </p>

                            <a asp-action="Create"
                               class="btn-add-caregiver">

                                <i class="bi bi-plus-lg"></i>

                                Add First Caregiver

                            </a>

                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table caregiver-table"
                                   id="caregiverTable">

                                <thead>

                                    <tr>

                                        <th>
                                            Caregiver
                                        </th>

                                        <th>
                                            Phone
                                        </th>

                                        <th>
                                            City
                                        </th>

                                        <th>
                                            Experience
                                        </th>

                                        <th>
                                            Availability
                                        </th>

                                        <th>
                                            NIN Status
                                        </th>

                                        <th>
                                            Rating
                                        </th>

                                        <th>
                                            Actions
                                        </th>

                                    </tr>

                                </thead>


                                <tbody>

                                    @foreach (var caregiver in caregivers)
                                    {
                                        var initials =
                                        (!string.IsNullOrWhiteSpace(caregiver.FirstName)
                                        ? caregiver.FirstName.Substring(0, 1)
                                        : "") +
                                        (!string.IsNullOrWhiteSpace(caregiver.LastName)
                                        ? caregiver.LastName.Substring(0, 1)
                                        : "");

                                        <tr class="caregiver-row"
                                            data-name="@($"{caregiver.FirstName} {caregiver.LastName}")"
                                            data-phone="@caregiver.PhoneNumber"
                                            data-city="@caregiver.City"
                                            data-available="@caregiver.IsAvaliable.ToString().ToLower()"
                                            data-nin="@caregiver.IsNinVerified.ToString().ToLower()">


                                            <!-- CAREGIVER -->

                                            <td>

                                                <div class="caregiver-profile">

                                                    <div class="caregiver-avatar">

                                                        @initials.ToUpper()

                                                    </div>

                                                    <div>

                                                        <div class="caregiver-name">

                                                            @caregiver.FirstName
                                                            @caregiver.LastName

                                                        </div>

                                                        <div class="caregiver-role">

                                                            <i class="bi bi-person"></i>

                                                            Caregiver

                                                        </div>

                                                    </div>

                                                </div>

                                            </td>


                                            <!-- PHONE -->

                                            <td>

                                                <i class="bi bi-telephone"
                                                   style="color:#94a3b8;margin-right:5px;"></i>

                                                @caregiver.PhoneNumber

                                            </td>


                                            <!-- CITY -->

                                            <td>

                                                <i class="bi bi-geo-alt"
                                                   style="color:#94a3b8;margin-right:4px;"></i>

                                                @caregiver.City

                                            </td>


                                            <!-- EXPERIENCE -->

                                            <td>

                                                <strong>
                                                    @caregiver.YearsOfExperience
                                                </strong>

                                                <span style="color:#64748b;">
                                                    years
                                                </span>

                                            </td>


                                            <!-- AVAILABILITY -->

                                            <td>

                                                @if (caregiver.IsAvaliable)
                                                {
                                                    <span class="status-badge status-available">

                                                        <i class="bi bi-circle-fill"></i>

                                                        Available

                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="status-badge status-unavailable">

                                                        <i class="bi bi-circle-fill"></i>

                                                        Unavailable

                                                    </span>
                                                }

                                            </td>


                                            <!-- NIN -->

                                            <td>

                                                @if (caregiver.IsNinVerified)
                                                {
                                                    <span class="status-badge status-verified">

                                                        <i class="bi bi-patch-check-fill"></i>

                                                        Verified

                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="status-badge status-pending">

                                                        <i class="bi bi-hourglass-split"></i>

                                                        Pending

                                                    </span>
                                                }

                                            </td>


                                            <!-- RATING -->

                                            <td>

                                                <div class="rating">

                                                    <i class="bi bi-star-fill rating-star"></i>

                                                    <span class="rating-value">

                                                        @caregiver.AverageRating.ToString("0.0")

                                                    </span>

                                                </div>

                                                <span class="rating-reviews">
                                                    Caregiver rating
                                                </span>

                                            </td>


                                            <!-- ACTIONS -->

                                            <td>

                                                <div class="action-buttons">


                                                    <!-- VIEW -->

                                                    <a asp-action="Details"
                                                       asp-route-id="@caregiver.Id"
                                                       class="action-btn action-view"
                                                       title="View caregiver">

                                                        <i class="bi bi-eye"></i>

                                                    </a>


                                                    <!-- EDIT -->

                                                    <a asp-action="Edit"
                                                       asp-route-id="@caregiver.Id"
                                                       class="action-btn action-edit"
                                                       title="Edit caregiver">

                                                        <i class="bi bi-pencil"></i>

                                                    </a>


                                                    <!-- DELETE -->

                                                    <form asp-action="Delete"
                                                          asp-route-id="@caregiver.Id"
                                                          method="post"
                                                          class="d-inline">

                                                        @Html.AntiForgeryToken()

                                                        <button type="submit"
                                                                class="action-btn action-delete"
                                                                title="Delete caregiver"
                                                                onclick="return confirm('Are you sure you want to delete this caregiver?');">

                                                            <i class="bi bi-trash3"></i>

                                                        </button>

                                                    </form>

                                                </div>

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>


                        <!-- TABLE FOOTER -->

                        <div class="table-footer">

                            <span class="table-count"
                                  id="tableCount">

                                Showing @totalCaregivers of @totalCaregivers caregivers

                            </span>


                            <div class="pagination-buttons">

                                <button class="page-btn">

                                    <i class="bi bi-chevron-left"></i>

                                </button>

                                <button class="page-btn active">
                                    1
                                </button>

                                <button class="page-btn">

                                    <i class="bi bi-chevron-right"></i>

                                </button>

                            </div>

                        </div>
                    }

                </div>


                <!-- =================================================
                     FOOTER
                ================================================== -->

                <div class="text-center mt-4 mb-2">

                    <small style="color:#94a3b8;font-size:9px;">

                        CareLink360 Healthcare Management

                        <span class="mx-2">•</span>

                        © @DateTime.Now.Year

                    </small>

                </div>


            </div>

        </main>

    </div>

</div>


<!-- =========================================================
     SEARCH / FILTER JAVASCRIPT
========================================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const searchInput =
            document.getElementById("caregiverSearch");

        const availabilityFilter =
            document.getElementById("availabilityFilter");

        const ninFilter =
            document.getElementById("ninFilter");

        const cityFilter =
            document.getElementById("cityFilter");

        const rows =
            document.querySelectorAll(".caregiver-row");

        const tableCount =
            document.getElementById("tableCount");


        /* =====================================================
           CREATE CITY OPTIONS
        ===================================================== */

        const cities = new Set();

        rows.forEach(row => {

            const city =
                row.dataset.city;

            if (city && city.trim() !== "") {

                cities.add(city.trim());

            }

        });


        cities.forEach(city => {

            const option =
                document.createElement("option");

            option.value = city.toLowerCase();

            option.textContent = city;

            cityFilter.appendChild(option);

        });


        /* =====================================================
           FILTER FUNCTION
        ===================================================== */

        function filterCaregivers() {

            const search =
                searchInput.value.toLowerCase().trim();

            const availability =
                availabilityFilter.value;

            const nin =
                ninFilter.value;

            const city =
                cityFilter.value;

            let visible = 0;


            rows.forEach(row => {

                const name =
                    (row.dataset.name || "").toLowerCase();

                const phone =
                    (row.dataset.phone || "").toLowerCase();

                const rowCity =
                    (row.dataset.city || "").toLowerCase();

                const isAvailable =
                    row.dataset.available;

                const isNinVerified =
                    row.dataset.nin;


                const matchesSearch =
                    name.includes(search) ||
                    phone.includes(search) ||
                    rowCity.includes(search);


                const matchesAvailability =
                    availability === "all" ||
                    (availability === "available"
                        && isAvailable === "true") ||
                    (availability === "unavailable"
                        && isAvailable === "false");


                const matchesNin =
                    nin === "all" ||
                    (nin === "verified"
                        && isNinVerified === "true") ||
                    (nin === "pending"
                        && isNinVerified === "false");


                const matchesCity =
                    city === "all" ||
                    rowCity === city;


                if (
                    matchesSearch &&
                    matchesAvailability &&
                    matchesNin &&
                    matchesCity
                ) {

                    row.style.display = "";

                    visible++;

                }
                else {

                    row.style.display = "none";

                }

            });


            tableCount.textContent =
                "Showing " +
                visible +
                " of " +
                rows.length +
                " caregivers";

        }


        /* =====================================================
           EVENTS
        ===================================================== */

        searchInput.addEventListener(
            "input",
            filterCaregivers
        );

        availabilityFilter.addEventListener(
            "change",
            filterCaregivers
        );

        ninFilter.addEventListener(
            "change",
            filterCaregivers
        );

        cityFilter.addEventListener(
            "change",
            filterCaregivers
        );

    });


    

    function resetCaregiverFilters() {

        document.getElementById("caregiverSearch").value = "";

        document.getElementById("availabilityFilter").value = "all";

        document.getElementById("ninFilter").value = "all";

        document.getElementById("cityFilter").value = "all";

        document.getElementById("caregiverSearch")
            .dispatchEvent(new Event("input"));

    }

</script>