@{
ViewData["Title"] = "My Profile";
}

<div class="profile-dashboard">

```
<div class="profile-header">
    <div>
        <span class="profile-label">CLIENT PROFILE</span>
        <h1>My Profile</h1>
        <p>View and manage your personal information.</p>
    </div>

    <a href="#" class="edit-btn">
        Edit Profile
    </a>
</div>

<div class="profile-card">

    <div class="profile-avatar">
        👤
    </div>

    <div class="profile-info">
        <h2>Client Information</h2>

        <div class="info-grid">

            <div class="info-item">
                <span>Full Name</span>
                <strong>Not available</strong>
            </div>

            <div class="info-item">
                <span>Email</span>
                <strong>Not available</strong>
            </div>

            <div class="info-item">
                <span>Phone Number</span>
                <strong>Not available</strong>
            </div>

            <div class="info-item">
                <span>Home Address</span>
                <strong>Not available</strong>
            </div>

            <div class="info-item">
                <span>City</span>
                <strong>Not available</strong>
            </div>

        </div>
    </div>

</div>
```

</div>

<style>

    .profile-dashboard {
        padding: 30px;
        max-width: 1200px;
        margin: auto;
    }

    .profile-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
        padding: 30px;
        background: linear-gradient(135deg, #eaf8f7, #f5fbfb);
        border-radius: 18px;
    }

    .profile-label {
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1.5px;
        color: #168b87;
    }

    .profile-header h1 {
        margin: 8px 0;
        color: #163b3b;
        font-size: 32px;
    }

    .profile-header p {
        margin: 0;
        color: #718080;
    }

    .edit-btn {
        padding: 12px 22px;
        background: #168b87;
        color: white;
        text-decoration: none;
        border-radius: 10px;
        font-weight: 600;
    }

    .edit-btn:hover {
        background: #116e6b;
        color: white;
    }

    .profile-card {
        display: flex;
        gap: 30px;
        background: white;
        padding: 35px;
        border-radius: 18px;
        box-shadow: 0 5px 20px rgba(0, 0, 0, 0.06);
    }

    .profile-avatar {
        width: 100px;
        height: 100px;
        min-width: 100px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eaf8f7;
        border-radius: 50%;
        font-size: 45px;
    }

    .profile-info {
        flex: 1;
    }

    .profile-info h2 {
        margin-top: 0;
        color: #163b3b;
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
        margin-top: 25px;
    }

    .info-item {
        padding: 18px;
        background: #f7fbfb;
        border-radius: 12px;
    }

    .info-item span {
        display: block;
        font-size: 13px;
        color: #7b8989;
        margin-bottom: 6px;
    }

    .info-item strong {
        color: #234646;
        font-size: 15px;
    }

    @@media (max-width: 700px) {

        .profile-dashboard {
            padding: 15px;
        }

        .profile-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .profile-card {
            flex-direction: column;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

    }

</style>
