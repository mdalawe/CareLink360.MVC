@model CareLink360.Application.DTOs.CreateMedicalRecordDto

@{
    ViewData["Title"] = "Create Medical Record";
}

<div class="container mt-4">

    <div class="card shadow">

        <div class="card-header bg-primary text-white">

            <h3>Create Medical Record</h3>

        </div>

        <div class="card-body">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger"></div>

                <div class="mb-3">

                    <label asp-for="CaregiverId"></label>

                    <input asp-for="CaregiverId"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label asp-for="BloodGroup"></label>

                    <select asp-for="BloodGroup"
                            class="form-select">

                        <option>A+</option>
                        <option>A-</option>
                        <option>B+</option>
                        <option>B-</option>
                        <option>AB+</option>
                        <option>AB-</option>
                        <option>O+</option>
                        <option>O-</option>

                    </select>

                </div>

                <div class="mb-3">

                    <label asp-for="VaccinationStatus"></label>

                    <input asp-for="VaccinationStatus"
                           class="form-control" />

                </div>

                <button class="btn btn-success">

                    Save

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}