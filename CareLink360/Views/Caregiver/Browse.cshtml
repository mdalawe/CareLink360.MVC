@model List<CareLink360.Application.DTOs.CaregiverResponseDto>

@{
    ViewData["Title"] = "Find a Caregiver";
    Layout = "_ClientLayout";
}

<div class="dashboard-card mb-3">

    <h5>Find a Caregiver</h5>

    <p class="subtitle mb-0">
        Browse approved, available caregivers
    </p>

</div>

@if (Model == null || !Model.Any())
{
    <div class="dashboard-table">

        <div class="empty-state">

            <i class="fa-solid fa-user-nurse"></i>

            No caregivers available right now.

        </div>

    </div>
}
else
{
    <div class="row g-3">

        @foreach (var caregiver in Model)
        {
            <div class="col-md-6 col-xl-4">

                <div class="dashboard-card h-100">

                    <div class="person-cell mb-2">

                        <div class="person-avatar">
                            @caregiver.FirstName.Substring(0, 1)@caregiver.LastName.Substring(0, 1)
                        </div>

                        <div>

                            <div class="person-name">
                                @caregiver.FirstName @caregiver.LastName
                            </div>

                            <div class="person-sub">
                                @caregiver.City
                            </div>

                        </div>

                    </div>

                    <div class="person-sub mb-1">

                        <i class="fa-solid fa-briefcase me-1"></i>

                        @caregiver.YearsOfExperience years experience

                    </div>

                    <div class="person-sub mb-3">

                        <i class="fa-solid fa-star text-warning me-1"></i>

                        @caregiver.AverageRating.ToString("0.0") rating

                    </div>

                    <a asp-controller="JobRequest"
                       asp-action="Create"
                       asp-route-caregiverId="@caregiver.Id"
                       class="btn btn-carelink w-100">

                        Request Care

                    </a>

                </div>

            </div>
        }

    </div>
}