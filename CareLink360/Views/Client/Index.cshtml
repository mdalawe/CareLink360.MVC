@model IEnumerable<CareLink360.Domain.Entities.Client>

@{
    ViewData["Title"] = "Clients";
    Layout = "_AdminLayout";
}

<style>
    /* =========================================
               CARELINK360 CLIENT MANAGEMENT
               ========================================= */

    .client-page {
        padding: 25px 0 90px;
    }

    .client-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        margin-bottom: 28px;
        flex-wrap: wrap;
    }

    .client-heading h2 {
        color: #17324d;
        font-size: 30px;
        font-weight: 700;
        margin-bottom: 7px;
    }

    .client-heading p {
        color: #718096;
        margin-bottom: 0;
        font-size: 15px;
    }

    .add-client-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(135deg, #16a085, #128c75);
        color: white;
        border: none;
        border-radius: 10px;
        padding: 12px 20px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.25s ease;
        box-shadow: 0 5px 15px rgba(22, 160, 133, 0.18);
    }

        .add-client-btn:hover {
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(22, 160, 133, 0.28);
        }

    .client-card {
        background: #ffffff;
        border: 1px solid #e7eef5;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(31, 60, 90, 0.08);
    }

    .client-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 22px 25px;
        background: linear-gradient(135deg, #f7fbfd, #eef8f8);
        border-bottom: 1px solid #e5edf3;
        flex-wrap: wrap;
    }

        .client-card-header h4 {
            margin: 0;
            color: #17324d;
            font-size: 20px;
            font-weight: 700;
        }

    .client-count {
        background: #e1f5ef;
        color: #128c75;
        padding: 7px 13px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 700;
    }

    .table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .client-table {
        width: 100%;
        min-width: 850px;
        margin-bottom: 0;
        border-collapse: collapse;
    }

        .client-table thead th {
            background: #17324d;
            color: white;
            padding: 17px 18px;
            border: none;
            font-size: 13px;
            font-weight: 600;
            white-space: nowrap;
        }

        .client-table tbody td {
            padding: 17px 18px;
            color: #526579;
            border-bottom: 1px solid #edf2f7;
            vertical-align: middle;
            font-size: 14px;
        }

        .client-table tbody tr {
            transition: background 0.2s ease;
        }

            .client-table tbody tr:hover {
                background: #f7fbfd;
            }

    .client-name {
        display: flex;
        align-items: center;
        gap: 12px;
        color: #17324d;
        font-weight: 700;
    }

    .client-avatar {
        width: 40px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: linear-gradient(135deg, #dff5f0, #c5ebe3);
        color: #128c75;
        font-weight: 700;
        flex-shrink: 0;
    }

    .phone-number {
        color: #1264d8;
        font-weight: 600;
    }

    .address-text {
        max-width: 240px;
        line-height: 1.5;
    }

    .action-buttons {
        display: flex;
        gap: 7px;
        flex-wrap: wrap;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 7px;
        padding: 8px 11px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .details-btn {
        background: #e7f1ff;
        color: #1264d8;
    }

        .details-btn:hover {
            background: #1264d8;
            color: white;
        }

    .edit-btn {
        background: #fff4d9;
        color: #b7791f;
    }

        .edit-btn:hover {
            background: #f0ad24;
            color: white;
        }

    .delete-btn {
        background: #ffe8e8;
        color: #d64545;
    }

        .delete-btn:hover {
            background: #d64545;
            color: white;
        }

    .empty-state {
        text-align: center;
        padding: 55px 20px;
        color: #718096;
    }

    .empty-icon {
        font-size: 45px;
        margin-bottom: 15px;
    }

    .empty-state h4 {
        color: #17324d;
        font-weight: 700;
        margin-bottom: 8px;
    }

    @@media (max-width: 768px) {
        .client-page {
            padding: 18px 0 90px;
        }

        .client-heading h2 {
            font-size: 25px;
        }

        .client-header {
            align-items: flex-start;
        }

        .add-client-btn {
            width: 100%;
            justify-content: center;
        }

        .client-card-header {
            padding: 18px;
        }

        .client-table thead th,
        .client-table tbody td {
            padding: 13px;
        }
    }
</style>

<div class="container-fluid client-page">

    <!-- PAGE HEADER -->
    <div class="client-header">

        <div class="client-heading">
            <h2>
                <i class="bi bi-people-fill me-2"></i>
                Client Management
            </h2>

            <p>
                Manage client profiles, contact details, and healthcare information.
            </p>
        </div>

        <a asp-action="Create" class="add-client-btn">
            <i class="bi bi-person-plus-fill"></i>
            Add Client
        </a>

    </div>

    <!-- CLIENT TABLE CARD -->
    <div class="client-card">

        <div class="client-card-header">

            <h4>
                Registered Clients
            </h4>

            <span class="client-count">
                @(Model?.Count() ?? 0) Clients
            </span>

        </div>

        @if (Model != null && Model.Any())
        {
            <div class="table-wrapper">

                <table class="client-table">

                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Phone Number</th>
                            <th>City</th>
                            <th>Home Address</th>
                            <th style="width: 245px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            var firstLetter = string.IsNullOrWhiteSpace(item.FullName)
                            ? "C"
                            : item.FullName.Trim().Substring(0, 1).ToUpper();

                            <tr>

                                <td>
                                    <div class="client-name">

                                        <span class="client-avatar">
                                            @firstLetter
                                        </span>

                                        <span>
                                            @(string.IsNullOrWhiteSpace(item.FullName)
                                                ? "Unnamed Client"
                                                : item.FullName)
                                        </span>

                                    </div>
                                </td>

                                <td>
                                    <span class="phone-number">
                                        @(string.IsNullOrWhiteSpace(item.PhoneNumber)
                                            ? "Not provided"
                                            : item.PhoneNumber)
                                    </span>
                                </td>

                                <td>
                                    @(string.IsNullOrWhiteSpace(item.City)
                                        ? "Not provided"
                                        : item.City)
                                </td>

                                <td>
                                    <div class="address-text">
                                        @(string.IsNullOrWhiteSpace(item.HomeAddress)
                                            ? "Not provided"
                                            : item.HomeAddress)
                                    </div>
                                </td>

                                <td>
                                    <div class="action-buttons">

                                        <a asp-action="Details"
                                           asp-route-id="@item.Id"
                                           class="action-btn details-btn">
                                            <i class="bi bi-eye me-1"></i>
                                            Details
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="action-btn edit-btn">
                                            <i class="bi bi-pencil-square me-1"></i>
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.Id"
                                           class="action-btn delete-btn">
                                            <i class="bi bi-trash me-1"></i>
                                            Delete
                                        </a>

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">

                <div class="empty-icon">
                    <i class="bi bi-people"></i>
                </div>

                <h4>No clients found</h4>

                <p>
                    You have not added any clients yet.
                </p>

                <a asp-action="Create" class="add-client-btn">
                    <i class="bi bi-person-plus-fill"></i>
                    Add Your First Client
                </a>

            </div>
        }

    </div>

</div>