@model CareLink360.Web.Models.ClientProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    Layout = "_ClientLayout";

    var displayName = string.IsNullOrWhiteSpace(Model.FullName)
        ? "Client"
        : Model.FullName.Trim();

    var initials = string.Join("", displayName
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(part => part.Substring(0, 1).ToUpper()));
}

<style>
    .profile-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 10px 0 35px;
        color: #173b43;
    }

    .profile-hero {
        background: linear-gradient(120deg, #e6f7f4, #f7fcfb);
        border: 1px solid #d9efeb;
        border-radius: 22px;
        padding: 30px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 25px;
    }

    .profile-eyebrow {
        color: #138779;
        text-transform: uppercase;
        letter-spacing: 1.5px;
        font-weight: 700;
        font-size: 11px;
        margin-bottom: 9px;
    }

    .profile-hero h2 {
        font-size: 28px;
        font-weight: 750;
        margin: 0 0 8px;
        color: #173b43;
    }

    .profile-hero p {
        color: #71858a;
        margin: 0;
        font-size: 14px;
    }

    .profile-edit-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        background: #118779;
        color: white;
        padding: 12px 19px;
        border-radius: 10px;
        text-decoration: none;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
        transition: .2s ease;
    }

        .profile-edit-btn:hover {
            background: #0d6f65;
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 7px 16px rgba(17, 135, 121, .18);
        }

    .profile-card {
        background: white;
        border: 1px solid #e8eeee;
        border-radius: 22px;
        padding: 32px;
        box-shadow: 0 8px 28px rgba(27, 64, 71, .06);
    }

    .profile-card-heading {
        display: flex;
        align-items: center;
        gap: 17px;
        margin-bottom: 30px;
        padding-bottom: 25px;
        border-bottom: 1px solid #edf1f1;
    }

    .profile-avatar {
        width: 76px;
        height: 76px;
        min-width: 76px;
        border-radius: 23px;
        background: linear-gradient(135deg, #d9f5ef, #effaf8);
        color: #118779;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
        font-weight: 800;
    }

    .profile-card-heading h3 {
        margin: 0 0 7px;
        font-size: 22px;
        font-weight: 750;
        color: #173b43;
        overflow-wrap: anywhere;
    }

    .profile-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 10px;
        background: #e9f8ef;
        color: #21834b;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .profile-section-title {
        font-size: 15px;
        font-weight: 750;
        color: #244a51;
        margin: 0 0 18px;
    }

    .profile-fields {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 17px;
    }

    .profile-field {
        background: #f7faf9;
        border: 1px solid #edf2f1;
        border-radius: 13px;
        padding: 18px;
        min-width: 0;
        transition: .2s ease;
    }

        .profile-field:hover {
            border-color: #cde8e2;
            background: #f3faf8;
        }

    .profile-field-label {
        color: #829397;
        font-size: 12px;
        margin-bottom: 9px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .profile-field-label i {
            color: #138779;
            width: 15px;
        }

    .profile-field-value {
        color: #203d43;
        font-size: 14px;
        font-weight: 650;
        overflow-wrap: anywhere;
    }

    .profile-note {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        margin-top: 22px;
        padding: 18px 20px;
        background: #f0f8ff;
        border: 1px solid #dfedfa;
        border-radius: 14px;
    }

    .profile-note-icon {
        color: #3579b8;
        font-size: 19px;
        margin-top: 2px;
    }

    .profile-note h4 {
        font-size: 13px;
        font-weight: 750;
        margin: 0 0 5px;
        color: #27557a;
    }

    .profile-note p {
        font-size: 12px;
        color: #658097;
        line-height: 1.7;
        margin: 0;
    }

    .profile-alert {
        padding: 13px 17px;
        border-radius: 11px;
        margin-bottom: 20px;
    }

    @@media (max-width: 650px) {
        .profile-hero {
            padding: 23px;
            align-items: flex-start;
            flex-direction: column;
        }

            .profile-hero h2 {
                font-size: 24px;
            }

        .profile-card {
            padding: 22px 17px;
        }

        .profile-card-heading {
            gap: 13px;
        }

        .profile-avatar {
            width: 60px;
            height: 60px;
            min-width: 60px;
            border-radius: 18px;
            font-size: 21px;
        }

        .profile-card-heading h3 {
            font-size: 18px;
        }

        .profile-fields {
            grid-template-columns: 1fr;
        }

        .profile-edit-btn {
            width: 100%;
        }
    }
</style>

<div class="profile-page">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success profile-alert">
            <i class="fa-solid fa-circle-check me-2"></i>
            @TempData["Success"]
        </div>
    }

    <section class="profile-hero">
        <div>
            <div class="profile-eyebrow">
                <i class="fa-solid fa-heart-pulse me-1"></i>
                Your CareLink360 Account
            </div>

            <h2>My Profile</h2>

            <p>Manage your personal details and contact information.</p>
        </div>

        <a asp-controller="ClientProfile"
           asp-action="Edit"
           class="profile-edit-btn">
            <i class="fa-solid fa-pen-to-square"></i>
            Edit Profile
        </a>
    </section>

    <section class="profile-card">

        <div class="profile-card-heading">
            <div class="profile-avatar">
                @(string.IsNullOrWhiteSpace(initials) ? "C" : initials)
            </div>

            <div>
                <h3>@displayName</h3>
                <span class="profile-status">
                    <i class="fa-solid fa-circle-check"></i>
                    Client Account
                </span>
            </div>
        </div>

        <h4 class="profile-section-title">
            <i class="fa-regular fa-address-card me-2"></i>
            Personal Information
        </h4>

        <div class="profile-fields">

            <div class="profile-field">
                <div class="profile-field-label">
                    <i class="fa-solid fa-user"></i>
                    Full Name
                </div>
                <div class="profile-field-value">
                    @(string.IsNullOrWhiteSpace(Model.FullName) ? "Not provided" : Model.FullName)
                </div>
            </div>

            <div class="profile-field">
                <div class="profile-field-label">
                    <i class="fa-solid fa-envelope"></i>
                    Email Address
                </div>
                <div class="profile-field-value">
                    @(string.IsNullOrWhiteSpace(Model.Email) ? "Not provided" : Model.Email)
                </div>
            </div>

            <div class="profile-field">
                <div class="profile-field-label">
                    <i class="fa-solid fa-phone"></i>
                    Phone Number
                </div>
                <div class="profile-field-value">
                    @(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not provided" : Model.PhoneNumber)
                </div>
            </div>

            <div class="profile-field">
                <div class="profile-field-label">
                    <i class="fa-solid fa-house"></i>
                    Home Address
                </div>
                <div class="profile-field-value">
                    @(string.IsNullOrWhiteSpace(Model.HomeAddress) ? "Not provided" : Model.HomeAddress)
                </div>
            </div>

            <div class="profile-field">
                <div class="profile-field-label">
                    <i class="fa-solid fa-location-dot"></i>
                    City
                </div>
                <div class="profile-field-value">
                    @(string.IsNullOrWhiteSpace(Model.City) ? "Not provided" : Model.City)
                </div>
            </div>

        </div>

        <div class="profile-note">
            <div class="profile-note-icon">
                <i class="fa-solid fa-shield-heart"></i>
            </div>

            <div>
                <h4>Keep your information up to date</h4>
                <p>
                    Accurate contact information helps CareLink360 keep you
                    informed about your caregiver requests and care arrangements.
                    Use Edit Profile whenever your details change.
                </p>
            </div>
        </div>

    </section>
</div>
